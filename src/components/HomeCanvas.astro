---
import { routeCategories } from '../data/site.js';
import { githubProfile, musicPlaylists, weatherLocations } from '../data/dashboard.js';
import FloatingNav from './FloatingNav.astro';

const primaryClusterIds = ['personal', 'ai', 'research', 'entertainment'];
const routeClusters = primaryClusterIds
  .map((id) => routeCategories.find((category) => category.id === id))
  .filter(Boolean)
  .map((category) => ({ ...category, items: category.items.slice(0, 4) }));
const secondaryGroups = routeCategories.filter((category) => !primaryClusterIds.includes(category.id));
const homeWeatherLocation = weatherLocations[0];
const homePlaylist = musicPlaylists.find((playlist) => playlist.name === '夜间低空飞行') ?? musicPlaylists[0];
const homePlaylistUrl = `https://music.163.com/playlist?id=${homePlaylist.id}`;
const today = new Date();
const dateLabel = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'long',
}).format(today);
const dateValue = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai' }).format(today);
const calendarDay = today.getDate();
const calendarMonth = new Intl.DateTimeFormat('zh-CN', { month: 'long' }).format(today);
const calendarWeekday = new Intl.DateTimeFormat('zh-CN', { weekday: 'short' }).format(today);
---

<section class="home-canvas" aria-labelledby="home-focus-title">
  <FloatingNav active="home" />

  <div class="home-heading">
    <p>PERSONAL HOME</p>
    <h1>熊窝</h1>
  </div>

  <div class="home-orbit home-orbit-outer" aria-hidden="true"></div>
  <div class="home-orbit home-orbit-inner" aria-hidden="true"></div>
  <span class="home-orbit-dot home-orbit-dot-a" aria-hidden="true"></span>
  <span class="home-orbit-dot home-orbit-dot-b" aria-hidden="true"></span>
  <span class="home-orbit-dot home-orbit-dot-c" aria-hidden="true"></span>
  <span class="home-orbit-dot home-orbit-dot-d" aria-hidden="true"></span>

  <a class="home-satellite home-satellite-weather" href="./dashboard/" data-home-weather data-latitude={homeWeatherLocation.latitude} data-longitude={homeWeatherLocation.longitude} title={`打开${homeWeatherLocation.name}天气详情`}>
    <p class="home-satellite-label">天气 · {homeWeatherLocation.name}</p>
    <strong data-home-weather-temperature>--°</strong>
    <span data-home-weather-label>正在获取天气…</span>
  </a>

  <a class="home-satellite home-satellite-calendar" href="./dashboard/" title="打开完整日历">
    <p class="home-satellite-label">日历</p>
    <strong>{calendarDay}</strong>
    <span>{calendarMonth} · {calendarWeekday}</span>
  </a>

  <a class="home-satellite home-satellite-music" href={homePlaylistUrl} target="_blank" rel="noopener" title={`在网易云音乐打开${homePlaylist.name}`}>
    <p class="home-satellite-label">我的歌单</p>
    <strong>{homePlaylist.name}</strong>
    <span>网易云音乐 · 打开 ↗</span>
  </a>

  <a class="home-satellite home-satellite-github" href={githubProfile.profileUrl} target="_blank" rel="noopener" title="打开 GitHub 主页">
    <p class="home-satellite-label">GitHub</p>
    <strong>{githubProfile.publicRepos}</strong>
    <span>公开仓库 · @{githubProfile.username}</span>
  </a>

  <article class="home-focus-node">
    <p class="home-focus-eyebrow">TODAY'S FOCUS</p>
    <div class="home-focus-ring" aria-hidden="true"><span>今天</span></div>
    <h2 id="home-focus-title">今天也慢慢过</h2>
    <time datetime={dateValue}>{dateLabel}</time>
    <p class="home-focus-copy">专注一件事，慢慢靠近目标。</p>
    <a class="home-focus-action" href="./dashboard/">打开今日看板 <span aria-hidden="true">↗</span></a>
  </article>

  {routeClusters.map((category, index) => (
    <article class:list={['home-route-cluster', `home-route-cluster-${index + 1}`]}>
      <header>
        <span class="home-cluster-icon" aria-hidden="true">{category.icon}</span>
        <div>
          <h2>{category.title}</h2>
          <small>{category.items.length} 个入口</small>
        </div>
      </header>
      <div class="home-route-links">
        {category.items.map((item) => (
          item.url ? (
            <a href={item.url} target="_blank" rel="noopener" title={item.desc}>
              {item.icon && <img src={item.icon} alt="" width="18" height="18" loading="lazy" />}
              <span>{item.name}</span>
              <b aria-hidden="true">↗</b>
            </a>
          ) : (
            <span title={item.desc}>
              <span>{item.name}</span>
            </span>
          )
        ))}
      </div>
    </article>
  ))}

  <article class="home-satellite home-satellite-habits">
    <p class="home-satellite-label">习惯</p>
    <strong data-home-tracker-title>今日摘要</strong>
    <div class="home-habit-dots" data-home-habit-dots aria-hidden="true"><i data-home-habit-dot></i><i data-home-habit-dot></i><i data-home-habit-dot></i><i data-home-habit-dot></i><i data-home-habit-dot></i></div>
    <span class="home-tracker-detail" data-home-tracker-detail>读取今日追踪…</span>
    <a href="./dashboard/">查看完整追踪 ↗</a>
  </article>

  <div class="home-secondary-routes" aria-label="其他路由分类">
    {secondaryGroups.map((category) => (
      <div class="home-secondary-group">
        <span><b aria-hidden="true">{category.icon}</b>{category.title}</span>
        <div>
          {category.items.slice(0, 3).map((item) => (
            item.url ? <a href={item.url} target="_blank" rel="noopener" title={item.desc}>{item.name}</a> : <span title={item.desc}>{item.name}</span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <a class="home-routes-entry" href="./routes/">查看全部路由 <span aria-hidden="true">→</span></a>
</section>

<script>
  const homeWeather = document.querySelector('[data-home-weather]');
  const weatherTemperature = homeWeather?.querySelector('[data-home-weather-temperature]');
  const weatherLabel = homeWeather?.querySelector('[data-home-weather-label]');
  const weatherCodeLabels = {
    0: '晴', 1: '大部晴朗', 2: '局部多云', 3: '阴', 45: '雾', 48: '雾凇',
    51: '小毛毛雨', 53: '毛毛雨', 55: '大毛毛雨', 61: '小雨', 63: '中雨', 65: '大雨',
    71: '小雪', 73: '中雪', 75: '大雪', 80: '阵雨', 81: '中阵雨', 82: '强阵雨',
    95: '雷雨', 96: '雷雨伴冰雹', 99: '强雷雨伴冰雹',
  };

  async function loadHomeWeather() {
    if (!homeWeather || !weatherTemperature || !weatherLabel) return;
    const forecastUrl = new URL('https://api.open-meteo.com/v1/forecast');
    forecastUrl.search = new URLSearchParams({
      latitude: homeWeather.dataset.latitude,
      longitude: homeWeather.dataset.longitude,
      current: 'temperature_2m,weather_code',
      temperature_unit: 'celsius',
      timezone: 'Asia/Shanghai',
    });
    try {
      const response = await fetch(forecastUrl);
      if (!response.ok) throw new Error(`天气接口返回 ${response.status}`);
      const payload = await response.json();
      const temperature = Number(payload.current?.temperature_2m);
      const code = Number(payload.current?.weather_code);
      if (!Number.isFinite(temperature)) throw new Error('没有可用的温度数据');
      weatherTemperature.textContent = `${Math.round(temperature)}°`;
      weatherLabel.textContent = weatherCodeLabels[code] ?? '天气已更新';
    } catch (error) {
      console.warn('[home-weather]', error);
      weatherTemperature.textContent = '—';
      weatherLabel.textContent = '天气暂不可用';
    }
  }

  function formatTrackerDuration(seconds) {
    const minutes = Math.floor(Math.max(0, Number(seconds || 0)) / 60);
    if (minutes < 60) return `${minutes} 分钟`;
    return `${Math.floor(minutes / 60)} 小时 ${minutes % 60} 分钟`;
  }

  function loadHomeTrackerSummary() {
    const detail = document.querySelector('[data-home-tracker-detail]');
    const dots = [...document.querySelectorAll('[data-home-habit-dot]')];
    if (!detail) return;
    const todayKey = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai' }).format(new Date());
    let record;
    try {
      const state = JSON.parse(localStorage.getItem('bear-home-tracker-v1') || '{}');
      record = state.dailyRecords?.[todayKey];
    } catch (error) {
      console.warn('[home-tracker]', error);
    }
    if (!record) {
      detail.textContent = '打开看板开始记录';
      dots.forEach((dot) => dot.classList.remove('is-done'));
      return;
    }
    const activeHabits = Object.values(record.habits || {}).filter((value) => Number(value) > 0).length;
    const workSeconds = Object.values(record.work?.timers || {}).reduce((sum, value) => sum + Math.max(0, Number(value || 0)), 0) + Math.max(0, Number(record.sideProject?.elapsed || 0));
    const pomodoros = Math.max(0, Number(record.pomodoro?.completed || 0));
    const doneDots = Math.min(dots.length, activeHabits);
    dots.forEach((dot, index) => dot.classList.toggle('is-done', index < doneDots));
    detail.textContent = `${activeHabits} 项记录 · 工作 ${formatTrackerDuration(workSeconds)} · 番茄 ${pomodoros}`;
  }

  loadHomeWeather();
  loadHomeTrackerSummary();
</script>

<style>
  .home-canvas {
    position: relative;
    min-height: max(880px, 100vh);
    overflow: hidden;
    isolation: isolate;
    color: #4d5e68;
  }

  .home-canvas::before,
  .home-canvas::after {
    position: absolute;
    z-index: -2;
    border-radius: 50%;
    content: '';
    filter: blur(8px);
    pointer-events: none;
  }

  .home-canvas::before {
    top: -18rem;
    left: 18%;
    width: 44rem;
    height: 44rem;
    background: rgba(191, 184, 214, .2);
  }

  .home-canvas::after {
    right: -14rem;
    bottom: -17rem;
    width: 42rem;
    height: 42rem;
    background: rgba(196, 211, 230, .28);
  }

  .home-heading {
    position: absolute;
    top: 2.1rem;
    left: 50%;
    z-index: 2;
    text-align: center;
    transform: translateX(-50%);
  }

  .home-heading p,
  .home-focus-eyebrow,
  .home-satellite-label {
    margin: 0;
    color: #8994a3;
    font-size: .64rem;
    font-weight: 800;
    letter-spacing: .16em;
  }

  .home-heading h1 {
    margin: .15rem 0 0;
    color: #526873;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    letter-spacing: .08em;
  }

  .home-orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid rgba(255, 255, 255, .52);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-13deg);
    pointer-events: none;
  }

  .home-orbit-outer {
    width: min(74vw, 73rem);
    height: min(63vw, 38rem);
  }

  .home-orbit-inner {
    width: min(52vw, 51rem);
    height: min(46vw, 29rem);
    border-color: rgba(255, 255, 255, .36);
    transform: translate(-50%, -50%) rotate(24deg);
  }

  .home-orbit-dot {
    position: absolute;
    width: .55rem;
    height: .55rem;
    border: 2px solid rgba(255, 255, 255, .85);
    border-radius: 50%;
    background: #c4b9d7;
    box-shadow: 0 0 0 .25rem rgba(255, 255, 255, .17);
  }

  .home-orbit-dot-a { top: 19%; left: 33%; }
  .home-orbit-dot-b { top: 32%; right: 21%; background: #b7cbdc; }
  .home-orbit-dot-c { right: 31%; bottom: 17%; background: #d2b9ad; }
  .home-orbit-dot-d { bottom: 22%; left: 24%; background: #abbfd0; }

  .home-focus-node,
  .home-route-cluster,
  .home-satellite,
  .home-secondary-routes {
    border: 1px solid rgba(255, 255, 255, .72);
    background: rgba(255, 255, 255, .42);
    box-shadow: 0 18px 42px rgba(89, 91, 117, .08), inset 0 1px 0 rgba(255, 255, 255, .62);
    backdrop-filter: blur(18px);
  }

  .home-focus-node {
    position: absolute;
    top: 53%;
    left: 50%;
    z-index: 3;
    display: flex;
    align-items: center;
    flex-direction: column;
    width: clamp(18rem, 25vw, 23rem);
    min-height: 24rem;
    padding: 2.2rem 2rem 1.8rem;
    border-radius: 46% 46% 42% 42% / 34% 34% 46% 46%;
    text-align: center;
    transform: translate(-50%, -49%);
  }

  .home-focus-ring {
    display: grid;
    place-items: center;
    width: 7rem;
    height: 7rem;
    margin: 1.1rem 0 .9rem;
    border: 8px solid rgba(188, 178, 211, .2);
    border-top-color: #aaa1c6;
    border-right-color: #bdcddd;
    border-radius: 50%;
    transform: rotate(20deg);
  }

  .home-focus-ring span {
    color: #7c719c;
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .08em;
    transform: rotate(-20deg);
  }

  .home-focus-node h2 {
    margin: 0;
    color: #455d67;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    letter-spacing: .04em;
  }

  .home-focus-node time {
    margin-top: .45rem;
    color: #8995a0;
    font-size: .78rem;
  }

  .home-focus-copy {
    margin: 1rem 0 1.2rem;
    color: #73818b;
    font-size: .82rem;
  }

  .home-focus-action,
  .home-satellite-habits a,
  .home-routes-entry {
    color: #786b9a;
    font-size: .76rem;
    font-weight: 800;
    text-decoration: none;
  }

  .home-focus-action {
    padding: .55rem .85rem;
    border: 1px solid rgba(174, 163, 202, .36);
    border-radius: 999px;
    background: rgba(255, 255, 255, .44);
  }

  .home-focus-action:hover,
  .home-routes-entry:hover,
  .home-satellite-habits a:hover {
    color: #5e527e;
    text-decoration: underline;
  }

  .home-satellite,
  .home-route-cluster {
    position: absolute;
    z-index: 2;
  }

  .home-satellite {
    min-width: 8.8rem;
    padding: 1rem 1.1rem;
    border-radius: 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  a.home-satellite:hover,
  a.home-satellite:focus-visible {
    outline: none;
    background: rgba(255, 255, 255, .58);
    box-shadow: 0 20px 44px rgba(89, 91, 117, .11), inset 0 1px 0 rgba(255, 255, 255, .72);
  }

  .home-satellite strong,
  .home-satellite span {
    display: block;
  }

  .home-satellite strong {
    margin-top: .35rem;
    color: #526974;
    font-size: 1.15rem;
  }

  .home-satellite span {
    margin-top: .25rem;
    color: #88949d;
    font-size: .68rem;
  }

  .home-satellite-weather {
    top: 13%;
    left: 50%;
    min-width: 9.5rem;
    transform: translateX(-50%) rotate(-3deg);
  }

  .home-satellite-weather strong { color: #7e6e9e; font-size: 1.7rem; }
  .home-satellite-calendar { top: 44%; left: 13%; transform: rotate(4deg); }
  .home-satellite-calendar strong { font-size: 2rem; }
  .home-satellite-music { top: 43%; right: 17%; transform: rotate(-4deg); }
  .home-satellite-music strong { font-size: .92rem; }
  .home-satellite-github { top: 47%; right: 2%; transform: rotate(5deg); }
  .home-satellite-github strong { color: #8799b0; font-size: 1.65rem; }

  .home-satellite-habits {
    top: 76.5%;
    left: 50%;
    min-width: 12rem;
    padding: .75rem 1rem;
    transform: translateX(-50%) rotate(2deg);
  }

  .home-satellite-habits strong { font-size: .88rem; }
  .home-satellite-habits a { display: inline-block; margin-top: .4rem; font-size: .67rem; }

  .home-habit-dots {
    display: flex;
    gap: .35rem;
    margin-top: .4rem;
  }

  .home-habit-dots i {
    width: .8rem;
    height: .8rem;
    border: 2px solid rgba(255, 255, 255, .8);
    border-radius: 50%;
    background: #b8c4d4;
    opacity: .3;
    transition: opacity .18s ease;
  }

  .home-habit-dots i.is-done { opacity: 1; }

  .home-habit-dots i:nth-child(2),
  .home-habit-dots i:nth-child(4) { background: #b7a9c9; }
  .home-habit-dots i:nth-child(3) { background: #d2b8aa; }

  .home-route-cluster {
    width: clamp(16rem, 24vw, 21rem);
    padding: 1rem 1.1rem;
    border-radius: 1.45rem;
  }

  .home-route-cluster header {
    display: flex;
    align-items: center;
    gap: .65rem;
    margin-bottom: .75rem;
  }

  .home-cluster-icon {
    display: grid;
    place-items: center;
    width: 1.95rem;
    height: 1.95rem;
    border-radius: .7rem;
    background: rgba(255, 255, 255, .52);
    font-size: 1rem;
  }

  .home-route-cluster h2 {
    margin: 0;
    color: #566b75;
    font-size: .9rem;
  }

  .home-route-cluster header small {
    color: #96a1aa;
    font-size: .62rem;
  }

  .home-route-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .42rem;
  }

  .home-route-links a,
  .home-route-links > span {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: .35rem;
    padding: .38rem .42rem;
    border: 1px solid rgba(255, 255, 255, .55);
    border-radius: .65rem;
    background: rgba(255, 255, 255, .32);
    color: #647782;
    font-size: .67rem;
    text-decoration: none;
  }

  .home-route-links a:hover {
    border-color: rgba(151, 137, 182, .42);
    background: rgba(255, 255, 255, .68);
    color: #6e608f;
  }

  .home-route-links img {
    flex: 0 0 auto;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: .25rem;
    object-fit: contain;
  }

  .home-route-links a span,
  .home-route-links > span > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-route-links b {
    margin-left: auto;
    color: #a19ab5;
    font-size: .65rem;
    font-weight: 500;
  }

  .home-route-cluster-1 { top: 21%; left: 7%; transform: rotate(-4deg); }
  .home-route-cluster-2 { top: 64%; left: 8%; transform: rotate(4deg); }
  .home-route-cluster-3 { top: 21%; right: 7%; transform: rotate(4deg); }
  .home-route-cluster-4 { top: 64%; right: 8%; transform: rotate(-4deg); }

  .home-secondary-routes {
    position: absolute;
    right: 50%;
    bottom: .5rem;
    left: 50%;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: .55rem;
    width: min(70vw, 58rem);
    padding: .55rem .7rem;
    border-radius: 1.2rem;
    transform: translateX(-50%);
  }

  .home-secondary-group {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: .45rem;
    padding: .25rem .4rem;
  }

  .home-secondary-group > span {
    flex: 0 0 auto;
    color: #788692;
    font-size: .65rem;
    font-weight: 800;
  }

  .home-secondary-group > span b { margin-right: .2rem; }

  .home-secondary-group > div {
    display: flex;
    gap: .3rem;
    min-width: 0;
  }

  .home-secondary-group a,
  .home-secondary-group div > span {
    overflow: hidden;
    max-width: 7rem;
    padding: .27rem .42rem;
    border-radius: .5rem;
    background: rgba(255, 255, 255, .36);
    color: #87939d;
    font-size: .62rem;
    text-overflow: ellipsis;
    text-decoration: none;
    white-space: nowrap;
  }

  .home-secondary-group a:hover {
    background: rgba(255, 255, 255, .7);
    color: #6e608f;
  }

  .home-routes-entry {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 3;
  }

  @media (max-width: 1100px) {
    .home-route-cluster { width: 15rem; }
    .home-route-cluster-1 { left: 2%; }
    .home-route-cluster-2 { left: 3%; }
    .home-route-cluster-3 { right: 2%; }
    .home-route-cluster-4 { right: 3%; }
    .home-satellite-calendar { left: 3%; }
    .home-satellite-music { right: 3%; }
    .home-satellite-github { right: 1%; }
  }

  @media (min-width: 720px) and (max-width: 900px) {
    .home-focus-node {
      width: min(17.5rem, 42vw);
      min-height: 22rem;
      padding: 1.8rem 1.35rem 1.5rem;
    }

    .home-route-cluster {
      width: 13rem;
      padding: .8rem;
    }

    .home-route-cluster-1,
    .home-route-cluster-3 { top: 22%; }

    .home-route-cluster-2,
    .home-route-cluster-4 { top: 64%; }

    .home-satellite-calendar { left: 1%; }
    .home-satellite-music { top: 37%; right: 1%; }
    .home-satellite-github { top: 50%; right: 0; }
  }

  @media (max-width: 719px) {
    .home-canvas {
      min-height: auto;
      padding: 5.2rem .85rem 2rem;
      overflow: visible;
    }

    .home-heading {
      position: relative;
      top: auto;
      left: auto;
      margin-bottom: 1.4rem;
      transform: none;
    }

    .home-orbit,
    .home-orbit-dot {
      display: none;
    }

    .home-focus-node,
    .home-satellite,
    .home-route-cluster,
    .home-secondary-routes,
    .home-routes-entry {
      position: relative;
      inset: auto;
      transform: none;
    }

    .home-focus-node {
      width: min(100%, 22rem);
      min-height: 20rem;
      margin: 0 auto 1.15rem;
      padding: 1.7rem 1.5rem 1.4rem;
    }

    .home-route-cluster,
    .home-satellite {
      width: 100%;
      min-width: 0;
      margin: 0 auto .75rem;
    }

    .home-route-cluster header { margin-bottom: .55rem; }
    .home-route-links { gap: .35rem; }

    .home-satellite-weather,
    .home-satellite-calendar,
    .home-satellite-music,
    .home-satellite-github,
    .home-satellite-habits {
      display: inline-block;
