---
import { trackerGoalDefinitions } from '../data/tracker-config.js';

const habits = [
  { id: 'water', name: 'Water', icon: '💧', initial: 0, target: 2200, tone: 'blue', ago: '--', step: 100 },
  { id: 'coffee', name: 'Coffee & Tea', icon: '☕', initial: 0, target: 4, tone: 'slate', ago: '--', step: 1 },
  { id: 'exercise', name: 'Exercise', icon: '💪', initial: 0, target: 6, tone: 'purple', ago: '--', step: 1 },
  { id: 'reading', name: 'Read 10 pages', icon: '📖', initial: 0, target: 10, tone: 'amber', ago: '--', step: 1 },
];
const work = [
  { id: 'inbox', name: 'Inbox', value: '00:00:00', subtitle: '工作总计', ago: '', icon: '🔵', tone: 'blue', large: true, seconds: 0, targetSeconds: 10800 },
  { id: 'blog-writing', name: 'Blog writing', value: '0 / 5', icon: '✍️', tone: 'blue', compact: true, count: 0, targetCount: 5 },
  { id: 'development', name: 'Development', value: '00:00:00', subtitle: '今日累计', ago: '', icon: '🔵', tone: 'blue', tall: true, seconds: 0, targetSeconds: 10800 },
];
const teas = [
  { id: 'green-tea', name: 'Green tea', duration: 180, tone: 'green', icon: '🍵' },
  { id: 'black-tea', name: 'Black tea', duration: 300, tone: 'orange', icon: '☕' },
  { id: 'herbal-tea', name: 'Herbal tea', duration: 600, tone: 'yellow', icon: '☕' },
];
const moneyGoals = trackerGoalDefinitions.filter((goal) => goal.type === 'money');
---

<section class="tracking-board" data-tracking-board aria-labelledby="tracking-board-title">
  <div class="tracking-board-toolbar">
    <div class="tracking-board-views" aria-label="追踪工作台视图">
      <button class="tracking-view-button active" type="button" data-tracking-view="cards" aria-label="当前看板视图" title="当前看板">▦</button>
      <button class="tracking-view-button" type="button" data-tracking-view="week" aria-label="本周看板" title="本周看板">◷</button>
      <button class="tracking-view-button" type="button" data-tracking-view="month" aria-label="本月看板" title="本月看板">▥</button>
      <button class="tracking-view-button" type="button" data-tracking-view="focus" aria-label="专注视图" title="专注视图">♟</button>
    </div>
    <div class="tracking-view-heading" data-tracking-view-heading hidden>
      <strong data-tracking-view-heading-title></strong>
      <small data-tracking-view-heading-range></small>
    </div>
    <div class="tracking-board-clock">
      <span>SESSION <strong data-work-session-clock>00:00:00</strong></span>
      <span>TOTAL <strong data-work-total-clock>00:00:00</strong></span>
    </div>
    <span class="tracking-sync-status" data-tracking-sync-status aria-live="polite"></span>
    <button class="tracking-board-settings" type="button" data-tracking-sync aria-label="同步追踪数据到站点" title="同步到站点">⇧</button>
  </div>

  <div class="tracking-board-body">
    <section class="tracking-board-section tracking-habits" aria-labelledby="tracking-board-title">
      <h2 id="tracking-board-title">HABITS</h2>
      <div class="tracking-habit-grid">
        {habits.map((habit) => (
          <article class:list={['tracking-habit-card', `tracking-tone-${habit.tone}`]} data-board-habit data-habit-id={habit.id} data-habit-target={habit.target} data-habit-initial={habit.initial} data-habit-step={habit.step}>
            <span class="tracking-card-edit" aria-hidden="true">↗</span>
            <button class="tracking-card-close" type="button" aria-label={`移除${habit.name}`}>×</button>
            <span class="tracking-habit-fill" aria-hidden="true"></span>
            <span class="tracking-habit-icon" aria-hidden="true">{habit.icon}</span>
            <div class="tracking-habit-copy">
              <strong><b data-board-habit-count>{habit.initial}</b>/{habit.target}</strong>
              <small>{habit.name}</small>
              <em>{habit.ago}</em>
            </div>
            <div class="tracking-card-actions">
              <button type="button" data-board-habit-decrease aria-label={`减少${habit.name}`}>−</button>
              <button type="button" data-board-habit-increase aria-label={`增加${habit.name}`}>＋</button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="tracking-board-section tracking-pomodoro" aria-labelledby="tracking-pomodoro-title">
      <h2 id="tracking-pomodoro-title">🍅 POMODORO</h2>
      <div class="tracking-pomodoro-grid">
        <article class="tracking-pomodoro-card" data-pomodoro-card><span class="tracking-pomodoro-icon" aria-hidden="true">🌟</span><div class="tracking-pomodoro-copy"><strong data-pomodoro-count>0 / 6</strong><small>Today</small><em>--</em></div><div class="tracking-card-actions"><button type="button" data-pomodoro-decrease aria-label="减少番茄钟完成数">−</button><button type="button" data-pomodoro-increase aria-label="增加番茄钟完成数">＋</button></div></article>
        <article class="tracking-timer-card"><span class="tracking-timer-icon" aria-hidden="true">🟠</span><div><strong>52:00</strong><small>52 Minutes</small></div><button type="button" data-board-timer data-countdown-id="pomodoro-work" data-seconds="3120" aria-label="开始工作计时">▶</button></article>
        <article class="tracking-timer-card"><span class="tracking-timer-icon" aria-hidden="true">🍩</span><div><strong>05:00</strong><small>5 mins break</small></div><button type="button" data-board-timer data-countdown-id="pomodoro-short-break" data-seconds="300" aria-label="开始短休息计时">▶</button></article>
        <article class="tracking-timer-card"><span class="tracking-timer-icon" aria-hidden="true">🍔</span><div><strong>25:00</strong><small>25 mins break</small></div><button type="button" data-board-timer data-countdown-id="pomodoro-long-break" data-seconds="1500" aria-label="开始长休息计时">▶</button></article>
      </div>
    </section>

    <div class="tracking-board-main-grid">
      <section class="tracking-board-section tracking-work" aria-labelledby="tracking-work-title">
        <h2 id="tracking-work-title">WORK</h2>
        <div class="tracking-work-grid">
          {work.map((item) => (
              <article class:list={['tracking-work-card', `tracking-tone-${item.tone}`, { 'tracking-work-large': item.large, 'tracking-work-tall': item.tall, 'tracking-work-compact': item.compact }]} data-work-card data-work-id={item.id} data-work-seconds={item.seconds} data-work-target={item.targetSeconds} data-work-count={item.count} data-work-count-target={item.targetCount}>
              <span class="tracking-card-edit" aria-hidden="true">↗</span>
              <button class="tracking-card-close" type="button" aria-label={`移除${item.name}`}>×</button>
              <span class="tracking-work-icon" aria-hidden="true">{item.icon}</span>
              <div class="tracking-work-copy">
                <strong data-work-time={item.seconds !== undefined ? true : undefined} data-work-count-value={item.count !== undefined ? true : undefined}>{item.value}</strong>
                <small>{item.name}</small>
                {item.ago && <em>{item.ago}</em>}
              </div>
              <div class="tracking-work-fill"><i></i></div>
              {(item.large || item.tall) && <span class="tracking-work-mascot" aria-hidden="true">🔵</span>}
              {(item.large || item.tall) && <button class="tracking-work-timer" type="button" data-work-timer data-work-id={item.id} data-work-seconds={item.seconds} data-work-target={item.targetSeconds}>{item.value}</button>}
              {!item.large && !item.tall && !item.compact && <em>{item.subtitle}</em>}
              {item.compact && <div class="tracking-card-actions"><button type="button" data-work-decrease aria-label={`减少${item.name}`}>−</button><button type="button" data-work-increase aria-label={`增加${item.name}`}>＋</button></div>}
            </article>
          ))}
        </div>
      </section>

      <section class="tracking-board-section tracking-side-project" aria-labelledby="tracking-side-title">
        <h2 id="tracking-side-title">SIDE PROJECT</h2>
        <article class="tracking-project-card" data-side-project>
          <span class="tracking-card-edit" aria-hidden="true">↗</span>
          <button class="tracking-card-close" type="button" aria-label="移除项目">×</button>
          <div class="tracking-project-copy"><strong data-project-time>00:00:00</strong><small>Project #1</small></div>
          <div class="tracking-project-orb" aria-hidden="true">🌙</div>
          <button class="tracking-project-timer" type="button" data-project-timer data-seconds="10800">03:00:00</button>
        </article>
      </section>

      <section class="tracking-board-section tracking-achievements" aria-labelledby="tracking-achievements-title">
        <h2 id="tracking-achievements-title">FINANCIAL STATUS</h2>
        <article class="tracking-achievement-card">
          <button class="tracking-card-close" type="button" aria-label="移除长期成就">×</button>
          <div class="tracking-achievement-heading"><strong>Personal finances</strong><small>Current overview</small></div>
          <div class="tracking-achievement-percent">—</div>
          {moneyGoals.map((goal) => (
            <div class="tracking-achievement-row"><span>{goal.icon}</span><strong>{goal.current}/{goal.target}</strong><small>{goal.label}</small></div>
          ))}
        </article>
      </section>
    </div>

    <section class="tracking-board-section tracking-tea" aria-labelledby="tracking-tea-title">
      <h2 id="tracking-tea-title">TEA TIMERS</h2>
      <div class="tracking-tea-grid">
        {teas.map((tea) => (
          <article class:list={['tracking-tea-card', `tracking-tone-${tea.tone}`]}>
            <span class="tracking-tea-icon" aria-hidden="true">{tea.icon}</span>
            <div><strong data-tea-time data-seconds={tea.duration}>{Math.floor(tea.duration / 60).toString().padStart(2, '0')}:00</strong><small>{tea.name}</small></div>
            <button type="button" data-board-timer data-countdown-id={tea.id} data-seconds={tea.duration} aria-label={`开始${tea.name}计时`}>▶</button>
          </article>
        ))}
      </div>
    </section>
  </div>

  <section class="tracking-history-view" data-tracking-view-panel="week" hidden aria-labelledby="tracking-week-title">
    <div class="tracking-history-heading tracking-week-subheading"><div><p>本周看板</p><h2 id="tracking-week-title">Weekly overview</h2></div><span data-history-range></span></div>
    <h3 class="tracking-week-summary-title">WEEK SUMMARY</h3>
    <div class="tracking-history-summary tracking-week-summary" data-history-summary></div>
    <div class="tracking-week-breakdown-heading"><h3>DAILY BREAKDOWN</h3><div class="tracking-week-legend"><span><i class="tracking-legend-work"></i>Work（h）</span><span><i class="tracking-legend-pomodoro"></i>Pomodoros</span><span><i class="tracking-legend-habit"></i>Habits %</span><span><i class="tracking-legend-best">★</i>Best day</span><span><i class="tracking-legend-streak">●</i>Streak day</span></div></div>
    <div class="tracking-history-grid" data-history-grid></div>
    <div class="tracking-week-insight-grid">
      <section class="tracking-week-insights"><h3>WEEKLY INSIGHTS</h3><div data-week-insights></div></section>
      <section class="tracking-week-panel tracking-week-trend"><h3>HABIT TREND</h3><div class="tracking-week-trend-chart" data-week-habit-trend></div><small>本周平均完成率</small></section>
      <section class="tracking-week-panel tracking-week-notes"><h3>📖 LAYOUT NOTES</h3><ul><li>每天的卡片显示习惯、工作与番茄钟。</li><li>星标代表本周投入最高的一天。</li><li>连续天数帮助你安排下一周节奏。</li></ul></section>
    </div>
    <div class="tracking-week-footer">
      <section class="tracking-week-footer-panel tracking-week-habit-legend"><h3>HABIT LEGEND <small>(Completion %)</small></h3><div>{habits.map((habit) => <span><i>{habit.icon}</i>{habit.name.replace('Read 10 pages', 'Read')}</span>)}<small class="tracking-week-legend-average">Average across<br />all 4 habits</small></div></section>
      <section class="tracking-week-footer-panel tracking-week-navigation"><h3>WEEK NAVIGATION</h3><div><button type="button" data-week-nav="previous" aria-label="上一周">←</button><b data-week-control-label></b><button type="button" data-week-nav="next" aria-label="下一周">→</button></div></section>
      <button class="tracking-week-export" type="button" data-week-export>⇧ <span>EXPORT WEEKLY REPORT</span></button>
    </div>
    <div class="tracking-history-note">每天的记录来自本地看板，按日期保留习惯、工作和番茄钟完成情况。</div>
  </section>

  <section class="tracking-history-view" data-tracking-view-panel="month" hidden aria-labelledby="tracking-month-title">
    <div class="tracking-history-heading tracking-month-subheading"><div><p>本月看板</p><h2 id="tracking-month-title">Monthly overview</h2></div><span data-history-range></span></div>
    <div class="tracking-month-summary" data-history-summary></div>
    <div class="tracking-month-main-grid">
      <section class="tracking-month-calendar-panel">
        <h3 data-month-calendar-title>MONTH OVERVIEW</h3>
        <div class="tracking-month-weekdays"><span>MON</span><span>TUE</span><span>WED</span><span>THU</span><span>FRI</span><span>SAT</span><span>SUN</span></div>
        <div class="tracking-month-grid" data-history-grid></div>
        <div class="tracking-month-legend" data-month-legend></div>
      </section>
      <div class="tracking-month-side-panels">
        <section class="tracking-month-panel tracking-work-type-panel"><h3>WORK TYPE SUMMARY <small>(HOURS)</small></h3><div data-month-breakdown></div></section>
        <section class="tracking-month-panel tracking-habit-type-panel"><h3>HABIT TYPE SUMMARY <small>(COMPLETION RATE)</small></h3><div data-month-habit-breakdown></div></section>
      </div>
    </div>
    <div class="tracking-month-insight-grid">
      <section class="tracking-month-insights"><h3>TREND INSIGHTS</h3><div data-month-insights></div></section>
      <section class="tracking-month-panel tracking-pomodoro-summary"><h3>🍅 POMODORO TRENDS</h3><div data-month-pomodoro-summary></div></section>
      <section class="tracking-month-panel tracking-month-notes"><h3>📖 LAYOUT NOTES</h3><ul><li>颜色越深代表当天工作投入越高。</li><li>彩色圆点代表当天完成过的习惯。</li><li>摘要数据来自当前浏览器快照。</li></ul></section>
    </div>
    <div class="tracking-month-controls">
      <section class="tracking-month-control-panel tracking-month-filter-panel">
        <h3>FILTERS</h3>
        <div class="tracking-month-navigation"><span>Month</span><button type="button" data-month-nav="previous" aria-label="上个月">←</button><b data-month-control-label></b><button type="button" data-month-nav="next" aria-label="下个月">→</button></div>
      </section>
      <section class="tracking-month-control-panel tracking-month-habit-filter-panel">
        <h3>HABIT FILTER</h3>
        <div class="tracking-month-filter">{habits.map((habit) => <label><input type="checkbox" checked data-month-habit-filter={habit.id} /><span><i>{habit.icon}</i>{habit.name.replace('Read 10 pages', 'Read')}</span></label>)}</div>
      </section>
      <section class="tracking-month-control-panel tracking-month-view-options">
        <h3>VIEW OPTIONS</h3>
        <label><input type="radio" name="tracking-month-view" value="calendar" checked data-month-view-option />Calendar</label>
        <label><input type="radio" name="tracking-month-view" value="heatmap" data-month-view-option />Heatmap</label>
      </section>
      <button class="tracking-month-export" type="button" data-month-export>⇧ <span>EXPORT MONTHLY REPORT</span></button>
    </div>
  </section>

  <section class="tracking-history-view tracking-goals-view" data-tracking-view-panel="focus" hidden aria-labelledby="tracking-focus-title">
    <div class="tracking-history-heading"><div><p>LONG-TERM GOALS</p><h2 id="tracking-focus-title">Where do my long-term goals stand now?</h2></div><span>GOAL STATUS</span></div>
    <h3 class="tracking-goal-summary-title">LONG-TERM SUMMARY</h3>
    <div class="tracking-goal-summary" data-goal-summary></div>
    <div class="tracking-goal-layout">
      <div class="tracking-goal-main-column">
        <section class="tracking-goal-section tracking-project-goals"><h3>PROJECT GOALS</h3><div class="tracking-goal-grid" data-goal-project-grid></div></section>
        <section class="tracking-goal-section tracking-money-goals"><h3>MONEY GOALS</h3><div class="tracking-goal-grid" data-goal-money-grid></div></section>
        <section class="tracking-goal-section tracking-goal-history"><h3>HISTORY</h3><div class="tracking-goal-grid tracking-goal-history-grid" data-goal-history-grid></div></section>
      </div>
      <aside class="tracking-goal-sidebar">
        <section class="tracking-goal-panel tracking-money-summary"><h3>MONEY GOALS SUMMARY</h3><div data-money-summary></div></section>
        <section class="tracking-goal-panel tracking-goal-notes"><h3>📖 LAYOUT NOTES</h3><ul><li>Top summary gives a quick overview of all goals.</li><li>Projects and money goals show live progress.</li><li>Each goal includes target, progress, status, and target completion date.</li><li>History keeps completed and archived goals visible for reference.</li><li>Use status filters to focus on what matters.</li></ul></section>
      </aside>
    </div>
    <div class="tracking-goal-controls">
      <section class="tracking-goal-control-panel tracking-goal-legend"><h3>HABIT LEGEND <small>(Projects &amp; Money Goals)</small></h3><div><span><i class="is-active">●</i>Active</span><span><i class="is-paused">Ⅱ</i>Paused</span><span><i class="is-completed">✓</i>Completed</span><span><i class="is-archived">▣</i>Archived</span></div></section>
      <section class="tracking-goal-control-panel tracking-goal-status-filter"><h3>GOAL STATUS FILTER</h3><div><button type="button" class="active" data-goal-filter="all">ALL</button><button type="button" data-goal-filter="active">ACTIVE</button><button type="button" data-goal-filter="paused">PAUSED</button><button type="button" data-goal-filter="completed">COMPLETED</button><button type="button" data-goal-filter="archived">ARCHIVED</button></div></section>
      <section class="tracking-goal-control-panel tracking-goal-navigation"><h3>WEEK NAVIGATION</h3><div><button type="button" data-goal-week-nav="previous" aria-label="上一周">←</button><b data-goal-week-label></b><button type="button" data-goal-week-nav="next" aria-label="下一周">→</button></div></section>
      <button class="tracking-goal-export" type="button" data-goal-export>⇧ <span>EXPORT GOALS REPORT</span></button>
    </div>
  </section>
</section>

<script>
  import { normalizeLongTermGoals, trackerGoalDefinitions } from '../data/tracker-config.js';

  const trackingBoard = document.querySelector('[data-tracking-board]');
  const trackerTimeZone = 'Asia/Shanghai';
  const trackerStorageKey = 'bear-home-tracker-v1';
  const isLocalDevelopment = ['localhost', '127.0.0.1'].includes(window.location.hostname);
  const trackerQuery = new URLSearchParams(window.location.search);
  function dateKey(date) {
    return new Intl.DateTimeFormat('en-CA', { timeZone: trackerTimeZone }).format(date);
  }
  function parseTrackerDate(value) {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(value || '')) return null;
    const [year, month, day] = value.split('-').map(Number);
    const date = new Date(Date.UTC(year, month - 1, day));
    return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day ? value : null;
  }
  const forcedTrackerDate = isLocalDevelopment ? parseTrackerDate(trackerQuery.get('tracker-date')) : null;
  const forcePublishedSnapshot = isLocalDevelopment && trackerQuery.get('tracker-source') === 'snapshot';
  function currentTrackerDate() {
    return forcedTrackerDate || dateKey(new Date());
  }
  let boardToday = currentTrackerDate();
  const habitDefinitions = [
    { id: 'water', name: 'Water', target: 2200, tone: 'blue' },
    { id: 'coffee', name: 'Coffee & Tea', target: 4, tone: 'slate' },
    { id: 'exercise', name: 'Exercise', target: 6, tone: 'purple' },
    { id: 'reading', name: 'Read 10 pages', target: 10, tone: 'amber' }
  ];

  if (trackingBoard) {
    let selectedWeekOffset = 0;
    let selectedMonthOffset = 0;
    let selectedMonthView = 'calendar';
    let selectedGoalWeekOffset = 0;
    const selectedMonthHabitIds = new Set(habitDefinitions.map((habit) => habit.id));
    let selectedGoalFilter = 'all';
    function earliestTrackerDate(...values) {
      return values.filter((value) => /^\d{4}-\d{2}-\d{2}$/.test(value || '')).sort()[0] || values.find(Boolean);
    }
    function createEmptyDayRecord() {
      return {
        habits: { water: 0, coffee: 0, exercise: 0, reading: 0 },
        work: { timers: { inbox: 0, development: 0 }, counts: { 'blog-writing': 0 } },
        pomodoro: { completed: 0 },
        countdowns: {},
        sideProject: { elapsed: 0, remaining: 10800 }
      };
    }
    function normalizeDayRecord(record) {
      const emptyRecord = createEmptyDayRecord();
      const source = record && typeof record === 'object' ? record : {};
      return {
        ...emptyRecord,
        ...source,
        habits: { ...emptyRecord.habits, ...(source.habits || {}) },
        work: {
          ...emptyRecord.work,
          ...(source.work || {}),
          timers: { ...emptyRecord.work.timers, ...(source.work?.timers || {}) },
          counts: { ...emptyRecord.work.counts, ...(source.work?.counts || {}) },
        },
        pomodoro: { ...emptyRecord.pomodoro, ...(source.pomodoro || {}) },
        countdowns: { ...emptyRecord.countdowns, ...(source.countdowns || {}) },
        sideProject: { ...emptyRecord.sideProject, ...(source.sideProject || {}) },
      };
    }
    const defaultLongTerm = {
      goals: trackerGoalDefinitions.map((goal) => ({ ...goal, startedAt: boardToday, completedAt: null }))
    };
    let trackerState = {};
    try { trackerState = JSON.parse(localStorage.getItem(trackerStorageKey) || '{}'); } catch { trackerState = {}; }
    if (!trackerState.version || !trackerState.dailyRecords || typeof trackerState.dailyRecords !== 'object') {
      trackerState = { version: 1, startedOn: boardToday, dailyRecords: {}, longTerm: defaultLongTerm };
    }
    trackerState.startedOn = trackerState.startedOn || boardToday;
    const storedLongTerm = trackerState.longTerm || {};
    trackerState.longTerm = {
      ...defaultLongTerm,
      ...storedLongTerm,
      goals: normalizeLongTermGoals(storedLongTerm.goals, trackerState.startedOn || boardToday),
    };
    trackerState.dailyRecords[boardToday] = normalizeDayRecord(trackerState.dailyRecords[boardToday]);
    const todayRecord = trackerState.dailyRecords[boardToday];
    function saveTracker() { localStorage.setItem(trackerStorageKey, JSON.stringify(trackerState)); }
    saveTracker();
    let historyState = trackerState;
    const syncStatus = trackingBoard.querySelector('[data-tracking-sync-status]');

    async function loadPublishedSnapshot() {
      try {
        const response = await fetch(new URL('/data/tracker-snapshot.json', document.baseURI));
        if (!response.ok) return;
        const snapshot = await response.json();
        if (snapshot?.schemaVersion === 1 && snapshot.dailyRecords) {
          if (isLocalDevelopment && !forcePublishedSnapshot) {
            let imported = false;
            Object.entries(snapshot.dailyRecords).forEach(([key, record]) => {
              if (Object.prototype.hasOwnProperty.call(trackerState.dailyRecords, key)) return;
              trackerState.dailyRecords[key] = normalizeDayRecord(record);
              imported = true;
            });
            const nextStartedOn = earliestTrackerDate(trackerState.startedOn, snapshot.startedOn);
            if (nextStartedOn !== trackerState.startedOn) {
              trackerState.startedOn = nextStartedOn;
              imported = true;
            }
            if (imported) saveTracker();
            historyState = trackerState;
          } else {
            historyState = {
              ...snapshot,
              longTerm: {
                ...(snapshot.longTerm || {}),
                goals: normalizeLongTermGoals(snapshot.longTerm?.goals, snapshot.startedOn),
              },
            };
          }
          renderWeekView();
          renderMonthView();
          renderLongTermView();
        }
      } catch { /* 静态页面无法读取快照时，保留当前视图 */ }
    }

    async function syncTrackerSnapshot() {
      trackerState.longTerm = {
        ...(trackerState.longTerm || {}),
        goals: normalizeLongTermGoals(trackerState.longTerm?.goals, trackerState.startedOn || boardToday),
      };
      saveTracker();
      if (!isLocalDevelopment) {
        if (syncStatus) syncStatus.textContent = '请在 localhost 同步';
        return;
      }
      if (syncStatus) syncStatus.textContent = '同步中…';
      try {
        const response = await fetch(`${window.location.origin}/__tracker_sync`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ schemaVersion: 1, snapshotAt: new Date().toISOString(), startedOn: trackerState.startedOn, dailyRecords: trackerState.dailyRecords, longTerm: trackerState.longTerm })
        });
        const responseText = await response.text();
        let result = {};
        try { result = JSON.parse(responseText); } catch { /* 非 JSON 响应 */ }
        if (!response.ok) throw new Error(result.error || `接口返回 ${response.status}`);
        if (syncStatus) syncStatus.textContent = result.changed ? '已同步' : '已是最新';
        window.setTimeout(() => { if (syncStatus) syncStatus.textContent = ''; }, 2800);
      } catch (error) {
        console.error('[tracker-sync]', error);
        if (syncStatus) syncStatus.textContent = '同步接口不可用';
      }
    }
    trackingBoard.querySelector('[data-tracking-sync]')?.addEventListener('click', syncTrackerSnapshot);
    loadPublishedSnapshot();
    const todayCounts = todayRecord.habits;
    const habitCards = [...trackingBoard.querySelectorAll('[data-board-habit]')];

    function renderBoardHabits() {
      habitCards.forEach((card) => {
        const count = Math.max(0, Number(todayCounts[card.dataset.habitId] ?? card.dataset.habitInitial ?? 0));
        const target = Number(card.dataset.habitTarget);
        const percentage = Math.min(100, (count / target) * 100);
        card.querySelector('[data-board-habit-count]').textContent = String(count);
        card.style.setProperty('--habit-fill', `${percentage}%`);
        card.style.setProperty('--habit-percent', String(percentage));
        card.toggleAttribute('data-habit-done', count >= Number(card.dataset.habitTarget));
      });
    }
    function saveBoardHabits() {
      saveTracker();
    }
    habitCards.forEach((card) => {
      const id = card.dataset.habitId;
      const step = Number(card.dataset.habitStep || 1);
      card.querySelector('[data-board-habit-decrease]').addEventListener('click', () => { todayCounts[id] = Math.max(0, Number(todayCounts[id] ?? card.dataset.habitInitial ?? 0) - step); saveBoardHabits(); renderBoardHabits(); });
      card.querySelector('[data-board-habit-increase]').addEventListener('click', () => { todayCounts[id] = Number(todayCounts[id] ?? card.dataset.habitInitial ?? 0) + step; saveBoardHabits(); renderBoardHabits(); });
    });
    renderBoardHabits();

    const workState = todayRecord.work;
    const workCards = [...trackingBoard.querySelectorAll('[data-work-card]')];
    const workIntervals = new Map();
    let activeWorkId;
    let sessionSeconds = 0;

    function formatWorkTime(totalSeconds) {
      const hours = Math.floor(totalSeconds / 3600).toString().padStart(2, '0');
      const minutes = Math.floor((totalSeconds % 3600) / 60).toString().padStart(2, '0');
      const seconds = (totalSeconds % 60).toString().padStart(2, '0');
      return `${hours}:${minutes}:${seconds}`;
    }

    function saveWork() {
      saveTracker();
    }

    function renderWorkSummary() {
      const sessionClock = trackingBoard.querySelector('[data-work-session-clock]');
      const totalClock = trackingBoard.querySelector('[data-work-total-clock]');
      const totalSeconds = Object.values(workState.timers || {}).reduce((sum, seconds) => sum + Math.max(0, Number(seconds || 0)), 0);
      if (sessionClock) sessionClock.textContent = formatWorkTime(activeWorkId ? sessionSeconds : 0);
      if (totalClock) totalClock.textContent = formatWorkTime(totalSeconds);
    }

    function renderWorkCard(card) {
      const id = card.dataset.workId;
      if (card.dataset.workSeconds !== undefined) {
        const seconds = Math.max(0, Number(workState.timers?.[id] ?? card.dataset.workSeconds ?? 0));
        const target = Math.max(1, Number(card.dataset.workTarget || 10800));
        const percentage = Math.min(100, (seconds / target) * 100);
        card.querySelector('[data-work-time]').textContent = formatWorkTime(seconds);
        card.querySelector('[data-work-timer]').textContent = formatWorkTime(seconds);
        card.style.setProperty('--work-fill', `${Math.max(2, percentage)}%`);
        card.style.setProperty('--work-percent', String(percentage));
        card.toggleAttribute('data-work-running', workIntervals.has(id));
      } else {
        const count = Math.max(0, Number(workState.counts?.[id] ?? card.dataset.workCount ?? 0));
        const target = Number(card.dataset.workCountTarget || 1);
        card.querySelector('[data-work-count-value]').textContent = `${count} / ${target}`;
      }
      renderWorkSummary();
    }

    workCards.forEach((card) => {
      const id = card.dataset.workId;
      if (card.dataset.workSeconds !== undefined) {
        card.querySelector('[data-work-timer]').addEventListener('click', () => {
          if (workIntervals.has(id)) {
            clearInterval(workIntervals.get(id));
            workIntervals.delete(id);
            if (activeWorkId === id) {
              activeWorkId = undefined;
              sessionSeconds = 0;
            }
            saveWork();
            renderWorkCard(card);
            return;
          }
          workIntervals.forEach((interval, runningId) => {
            clearInterval(interval);
            workIntervals.delete(runningId);
            const runningCard = trackingBoard.querySelector(`[data-work-card][data-work-id="${runningId}"]`);
            if (runningCard) runningCard.removeAttribute('data-work-running');
          });
          activeWorkId = id;
          sessionSeconds = 0;
          if (!workState.timers) workState.timers = {};
          workIntervals.set(id, setInterval(() => {
            workState.timers[id] = Number(workState.timers[id] ?? card.dataset.workSeconds ?? 0) + 1;
            sessionSeconds += 1;
            renderWorkCard(card);
            if (workState.timers[id] % 5 === 0) saveWork();
          }, 1000));
          renderWorkCard(card);
        });
      } else {
        if (!workState.counts) workState.counts = {};
        card.querySelector('[data-work-decrease]').addEventListener('click', () => {
          workState.counts[id] = Math.max(0, Number(workState.counts[id] ?? card.dataset.workCount ?? 0) - 1);
          saveWork();
          renderWorkCard(card);
        });
        card.querySelector('[data-work-increase]').addEventListener('click', () => {
          workState.counts[id] = Number(workState.counts[id] ?? card.dataset.workCount ?? 0) + 1;
          saveWork();
          renderWorkCard(card);
        });
      }
      renderWorkCard(card);
    });
    renderWorkSummary();

    const pomodoroState = todayRecord.pomodoro;
    const pomodoroCard = trackingBoard.querySelector('[data-pomodoro-card]');
    const pomodoroCount = pomodoroCard?.querySelector('[data-pomodoro-count]');
    function renderPomodoroCount() {
      if (pomodoroCount) pomodoroCount.textContent = `${Math.max(0, Number(pomodoroState.completed ?? 4))} / 6`;
    }
    pomodoroCard?.querySelector('[data-pomodoro-decrease]')?.addEventListener('click', () => {
      pomodoroState.completed = Math.max(0, Number(pomodoroState.completed ?? 4) - 1);
      saveTracker();
      renderPomodoroCount();
    });
    pomodoroCard?.querySelector('[data-pomodoro-increase]')?.addEventListener('click', () => {
      pomodoroState.completed = Math.min(6, Number(pomodoroState.completed ?? 4) + 1);
      saveTracker();
      renderPomodoroCount();
    });
    renderPomodoroCount();

    const countdownState = todayRecord.countdowns;
    const countdownIntervals = new Map();
    function formatCountdown(totalSeconds) {
      const minutes = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
      const seconds = (totalSeconds % 60).toString().padStart(2, '0');
      return `${minutes}:${seconds}`;
    }
    function renderCountdown(button, remaining) {
      const timerCard = button.closest('.tracking-timer-card');
      const teaCard = button.closest('.tracking-tea-card');
      if (timerCard) timerCard.querySelector('strong').textContent = formatCountdown(remaining);
      if (teaCard) teaCard.querySelector('[data-tea-time]').textContent = formatCountdown(remaining);
      button.textContent = countdownIntervals.has(button.dataset.countdownId) ? 'Ⅱ' : '▶';
    }
    trackingBoard.querySelectorAll('[data-board-timer]').forEach((button) => {
      const id = button.dataset.countdownId;
      let remaining = Math.max(0, Number(countdownState[id] ?? button.dataset.seconds ?? 0));
      renderCountdown(button, remaining);
      button.addEventListener('click', () => {
        if (countdownIntervals.has(id)) {
          clearInterval(countdownIntervals.get(id));
          countdownIntervals.delete(id);
          countdownState[id] = remaining;
          saveTracker();
          renderCountdown(button, remaining);
          return;
        }
        if (remaining <= 0) remaining = Number(button.dataset.seconds || 0);
        countdownIntervals.set(id, setInterval(() => {
          remaining = Math.max(0, remaining - 1);
          countdownState[id] = remaining;
          renderCountdown(button, remaining);
          if (remaining % 5 === 0) saveTracker();
          if (remaining <= 0) {
            clearInterval(countdownIntervals.get(id));
            countdownIntervals.delete(id);
            saveTracker();
            renderCountdown(button, remaining);
          }
        }, 1000));
        renderCountdown(button, remaining);
      });
    });

    const sideProjectState = todayRecord.sideProject;
    const sideProject = trackingBoard.querySelector('[data-side-project]');
    const sideProjectTimer = sideProject?.querySelector('[data-project-timer]');
    let sideProjectInterval;
    function renderSideProject() {
      if (!sideProject || !sideProjectTimer) return;
      const elapsed = Math.max(0, Number(sideProjectState.elapsed ?? 0));
      const remaining = Math.max(0, Number(sideProjectState.remaining ?? sideProjectTimer.dataset.seconds ?? 10800));
      sideProject.querySelector('[data-project-time]').textContent = formatWorkTime(elapsed);
      sideProjectTimer.textContent = formatWorkTime(remaining);
      sideProject.style.setProperty('--project-fill', `${Math.min(100, (elapsed / 10800) * 100)}%`);
      sideProject.toggleAttribute('data-project-running', Boolean(sideProjectInterval));
    }
    sideProjectTimer?.addEventListener('click', () => {
      if (sideProjectInterval) {
        clearInterval(sideProjectInterval);
        sideProjectInterval = undefined;
        saveTracker();
        renderSideProject();
        return;
      }
      if (Number(sideProjectState.remaining ?? sideProjectTimer.dataset.seconds) <= 0) return;
      sideProjectInterval = setInterval(() => {
        sideProjectState.elapsed = Number(sideProjectState.elapsed ?? 0) + 1;
        sideProjectState.remaining = Math.max(0, Number(sideProjectState.remaining ?? sideProjectTimer.dataset.seconds) - 1);
        renderSideProject();
        if (sideProjectState.elapsed % 5 === 0) saveTracker();
        if (sideProjectState.remaining <= 0) {
          clearInterval(sideProjectInterval);
          sideProjectInterval = undefined;
          saveTracker();
          renderSideProject();
        }
      }, 1000);
      renderSideProject();
    });
    renderSideProject();

    function formatShortDuration(seconds) {
      const totalMinutes = Math.floor(Math.max(0, Number(seconds || 0)) / 60);
      if (totalMinutes < 60) return `${totalMinutes}m`;
      return `${Math.floor(totalMinutes / 60)}h ${totalMinutes % 60}m`;
    }

    function getDayRecord(key) {
      const dailyRecords = historyState?.dailyRecords || trackerState?.dailyRecords || {};
      return dailyRecords[key] || { habits: {}, work: { timers: {}, counts: {} }, pomodoro: { completed: 0 }, sideProject: { elapsed: 0 } };
    }

    function getDayStats(date) {
      const key = dateKey(date);
      const record = getDayRecord(key);
      const workSeconds = Object.values(record.work?.timers || {}).reduce((sum, value) => sum + Number(value || 0), 0) + Number(record.sideProject?.elapsed || 0);
      const completedHabits = habitDefinitions.reduce((sum, habit) => sum + (Number(record.habits?.[habit.id] || 0) >= habit.target ? 1 : 0), 0);
      const habitCount = habitDefinitions.reduce((sum, habit) => sum + (Number(record.habits?.[habit.id] || 0) > 0 ? 1 : 0), 0);
      const habitPercentage = Math.round((habitDefinitions.reduce((sum, habit) => sum + Math.min(1, Number(record.habits?.[habit.id] || 0) / habit.target), 0) / habitDefinitions.length) * 100);
      const pomodoros = Number(record.pomodoro?.completed || 0);
      return {
        date,
        key,
        record,
        workSeconds,
        pomodoros,
        completedHabits,
        habitCount,
        habitPercentage,
        isActive: workSeconds > 0 || pomodoros > 0 || habitCount > 0,
      };
    }

    function summarizeDays(days) {
      const dayStats = days.map(getDayStats);
      const workTotal = dayStats.reduce((sum, day) => sum + day.workSeconds, 0);
      const pomodoroTotal = dayStats.reduce((sum, day) => sum + day.pomodoros, 0);
      const habitTotal = dayStats.reduce((sum, day) => sum + day.completedHabits, 0);
      const activeDays = dayStats.filter((day) => day.isActive).length;
      const habitRate = Math.round(dayStats.reduce((sum, day) => sum + day.habitPercentage, 0) / Math.max(days.length, 1));
      const bestDay = [...dayStats].filter((day) => day.isActive).sort((a, b) => (b.workSeconds + b.completedHabits * 900 + b.pomodoros * 1500) - (a.workSeconds + a.completedHabits * 900 + a.pomodoros * 1500))[0];
      const busiestDay = [...dayStats].filter((day) => day.workSeconds > 0).sort((a, b) => b.workSeconds - a.workSeconds)[0];
      const latestDayIndex = dayStats.reduce((latestIndex, day, index) => day.key <= boardToday ? index : latestIndex, -1);
      let currentStreak = 0;
      for (let index = latestDayIndex; index >= 0 && dayStats[index].isActive; index -= 1) currentStreak += 1;
      let streak = 0;
      dayStats.forEach((day) => { day.streak = day.isActive ? streak + 1 : 0; streak = day.streak; });
      return { dayStats, workTotal, pomodoroTotal, habitTotal, activeDays, habitRate, bestDay, busiestDay, currentStreak };
    }

    function formatSignedDuration(value) {
      if (!value) return '较上期持平';
      return `较上期 ${value > 0 ? '+' : '-'}${formatShortDuration(Math.abs(value))}`;
    }

    function formatSignedNumber(value, suffix = '') {
      if (!value) return '较上期持平';
      return `较上期 ${value > 0 ? '+' : ''}${value}${suffix}`;
    }

    function getWeekDays(weekOffset = selectedWeekOffset) {
      const today = new Date(`${boardToday}T12:00:00`);
      const day = today.getDay() || 7;
      const monday = new Date(today);
      monday.setDate(today.getDate() - day + 1 + weekOffset * 7);
      return Array.from({ length: 7 }, (_, index) => {
        const date = new Date(monday);
        date.setDate(monday.getDate() + index);
        return date;
      });
    }

    function renderWeekView() {
      const days = getWeekDays();
      const panel = trackingBoard.querySelector('[data-tracking-view-panel="week"]');
      const grid = panel?.querySelector('[data-history-grid]');
      if (!panel || !grid) return;
      const range = panel.querySelector('[data-history-range]');
      if (range) range.textContent = `${dateKey(days[0])} — ${dateKey(days[6])}`;
      const summaryData = summarizeDays(days);
      const previous = summarizeDays(getWeekDays(selectedWeekOffset - 1));
      const { dayStats, workTotal, pomodoroTotal, habitTotal, activeDays, habitRate, bestDay, currentStreak } = summaryData;
      grid.innerHTML = dayStats.map((day) => {
        const isBest = day.key === bestDay?.key && day.isActive;
        const isToday = day.key === boardToday;
        const isStreakDay = day.isActive && !isBest;
        const state = isBest ? 'best' : day.isActive ? 'active' : 'rest';
        const statusIcon = isBest ? '★' : isStreakDay ? '●' : '○';
        const statusText = isBest ? 'BEST DAY' : day.isActive ? `STREAK +${day.streak}` : 'NO RECORD';
        const note = isBest ? 'Best day!' : day.isActive ? (day.completedHabits ? 'Steady progress' : 'Work recorded') : 'Rest day';
        return `<article class="tracking-week-day-card is-${state}${isToday ? ' is-today' : ''}" style="--day-percent:${day.habitPercentage}%"><header><div><strong>${day.date.toLocaleDateString('en-US', { weekday: 'long' })}</strong><small>${day.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</small></div><b aria-label="${statusText}">${statusIcon}</b></header><div class="tracking-week-progress"><span><b>${day.habitPercentage}%</b></span></div><div class="tracking-week-metrics"><span>◷ <b>${formatWorkTime(day.workSeconds)}</b></span><span>🍅 <b>${day.pomodoros}</b></span></div><div class="tracking-week-note"><small>${note}</small><em>${statusText}</em></div></article>`;
      }).join('');
      const summary = panel.querySelector('[data-history-summary]');
      const barSet = (values) => {
        const max = Math.max(...values, 1);
        return values.map((value) => `<i style="height:${Math.max(15, Math.round((value / max) * 100))}%"></i>`).join('');
      };
      if (summary) summary.innerHTML = `<article class="tracking-week-summary-card tracking-week-summary-work"><span class="tracking-week-summary-icon" aria-hidden="true">🕒</span><div class="tracking-week-summary-copy"><b>${formatShortDuration(workTotal)}</b><small>Total work hours</small><em>${formatSignedDuration(workTotal - previous.workTotal)}</em></div><span class="tracking-week-summary-action is-trend" aria-label="工作时长趋势">${barSet(dayStats.map((day) => day.workSeconds))}</span></article><article class="tracking-week-summary-card tracking-week-summary-habits"><span class="tracking-week-summary-icon" aria-hidden="true">💪</span><div class="tracking-week-summary-copy"><b>${habitRate}%</b><small>Habit completion rate</small><em>${formatSignedNumber(habitRate - previous.habitRate, '%')} · ${activeDays} active day${activeDays === 1 ? '' : 's'}</em></div><span class="tracking-week-summary-action is-trend" aria-label="习惯趋势">${barSet(dayStats.map((day) => day.habitPercentage))}</span></article><article class="tracking-week-summary-card tracking-week-summary-pomodoros"><span class="tracking-week-summary-icon" aria-hidden="true">🍅</span><div class="tracking-week-summary-copy"><b>${pomodoroTotal}</b><small>Total pomodoros</small><em>${formatSignedNumber(pomodoroTotal - previous.pomodoroTotal)} · This week total</em></div><span class="tracking-week-summary-action is-trend" aria-label="番茄钟趋势">${barSet(dayStats.map((day) => day.pomodoros))}</span></article><article class="tracking-week-summary-card tracking-week-summary-streak"><span class="tracking-week-summary-icon" aria-hidden="true">⭐</span><div class="tracking-week-summary-copy"><b>${currentStreak} days</b><small>Current streak</small><em>${bestDay ? `Best: ${bestDay.key.slice(5)}` : 'No record yet'}</em></div><span class="tracking-week-summary-action is-calendar" aria-label="连续记录日历"><i></i></span></article>`;
      const control = panel.querySelector('[data-week-control-label]');
      if (control) control.textContent = `${dateKey(days[0])} — ${dateKey(days[6])}`;
      const nextButton = panel.querySelector('[data-week-nav="next"]');
      if (nextButton) nextButton.disabled = selectedWeekOffset >= 0;
      const insights = panel.querySelector('[data-week-insights]');
      if (insights) insights.innerHTML = `<article><strong>★</strong><small>BEST DAY</small><b>${bestDay ? bestDay.date.toLocaleDateString('zh-CN', { weekday: 'long' }) : '—'}</b><span>${bestDay ? formatShortDuration(bestDay.workSeconds) : '暂无数据'}</span></article><article><strong>◷</strong><small>MOST ACTIVE</small><b>${activeDays} days</b><span>${formatShortDuration(workTotal)} 工作</span></article><article><strong>⚠</strong><small>NEEDS ATTENTION</small><b>${activeDays < 7 ? '休息日' : '保持节奏'}</b><span>${activeDays < 7 ? `${7 - activeDays} 天没有记录` : '本周每天都有活动'}</span></article>`;
      const trend = panel.querySelector('[data-week-habit-trend]');
      if (trend) {
        const chartWidth = 180;
        const chartHeight = 74;
        const points = dayStats.map((day, index) => `${12 + index * 26},${chartHeight - 10 - Math.round(day.habitPercentage * .56)}`).join(' ');
        const circles = dayStats.map((day, index) => `<circle cx="${12 + index * 26}" cy="${chartHeight - 10 - Math.round(day.habitPercentage * .56)}" r="3" tabindex="0"><title>${day.key}：${day.habitPercentage}%</title></circle>`).join('');
        const labels = dayStats.map((day) => `<span>${day.date.toLocaleDateString('zh-CN', { weekday: 'short' }).replace('周', '')}</span>`).join('');
        trend.innerHTML = `<div class="tracking-week-trend-plot"><svg viewBox="0 0 ${chartWidth} ${chartHeight}" role="img" aria-label="每日习惯完成率趋势"><line x1="10" y1="64" x2="174" y2="64"></line><line x1="10" y1="36" x2="174" y2="36"></line><polyline points="${points}"></polyline>${circles}</svg><div>${labels}</div></div>`;
      }
    }

    function getMonthDate(offset = selectedMonthOffset) {
      const date = new Date(`${boardToday}T12:00:00`);
      date.setDate(1);
      date.setMonth(date.getMonth() + offset);
      return date;
    }

    function getMonthAggregate(monthDate, selectedHabits = habitDefinitions) {
      const year = monthDate.getFullYear();
      const month = monthDate.getMonth();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      let workTotal = 0;
      let activeDays = 0;
      let habitTotal = 0;
      let pomodoroTotal = 0;
      for (let index = 1; index <= daysInMonth; index += 1) {
        const date = new Date(year, month, index, 12);
        const record = getDayRecord(dateKey(date));
        const workSeconds = Object.values(record.work?.timers || {}).reduce((sum, value) => sum + Number(value || 0), 0) + Number(record.sideProject?.elapsed || 0);
        const habitCount = selectedHabits.reduce((sum, habit) => sum + (Number(record.habits?.[habit.id] || 0) > 0 ? 1 : 0), 0);
        const completedHabits = selectedHabits.reduce((sum, habit) => sum + (Number(record.habits?.[habit.id] || 0) >= habit.target ? 1 : 0), 0);
        const pomodoros = Number(record.pomodoro?.completed || 0);
        workTotal += workSeconds;
        habitTotal += completedHabits;
        pomodoroTotal += pomodoros;
        if (workSeconds > 0 || habitCount > 0 || pomodoros > 0) activeDays += 1;
      }
      return { workTotal, activeDays, habitTotal, pomodoroTotal, daysInMonth };
    }

    function renderMonthView() {
      const today = getMonthDate();
      const year = today.getFullYear();
      const month = today.getMonth();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const panel = trackingBoard.querySelector('[data-tracking-view-panel="month"]');
      const grid = panel?.querySelector('[data-history-grid]');
      if (!panel || !grid) return;
      const monthLabel = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(today);
      panel.querySelector('[data-history-range]').textContent = `${year} 年 ${month + 1} 月`;
      panel.querySelector('[data-month-calendar-title]').textContent = `${monthLabel.toUpperCase()} OVERVIEW`;
      panel.querySelector('[data-month-control-label]').textContent = monthLabel;
      const selectedHabits = habitDefinitions.filter((habit) => selectedMonthHabitIds.has(habit.id));
      const currentAggregate = getMonthAggregate(today, selectedHabits);
      const previousAggregate = getMonthAggregate(getMonthDate(selectedMonthOffset - 1), selectedHabits);
      const workTotal = currentAggregate.workTotal;
      const activeDays = currentAggregate.activeDays;
      const categoryTotals = {};
      const habitTotal = currentAggregate.habitTotal;
      const pomodoroTotal = currentAggregate.pomodoroTotal;
      const habitStats = Object.fromEntries(selectedHabits.map((habit) => [habit.id, { ...habit, active: 0, completed: 0, progress: 0, percentage: 0 }]));
      const dayStats = [];
      for (let index = 0; index < daysInMonth; index += 1) {
        const date = new Date(year, month, index + 1, 12);
        const key = dateKey(date);
        const record = getDayRecord(key);
        const workSeconds = Object.values(record.work?.timers || {}).reduce((sum, value) => sum + Number(value || 0), 0) + Number(record.sideProject?.elapsed || 0);
        const habitCount = selectedHabits.reduce((sum, habit) => sum + (Number(record.habits?.[habit.id] || 0) > 0 ? 1 : 0), 0);
        const completedHabits = selectedHabits.reduce((sum, habit) => {
          const numericValue = Number(record.habits?.[habit.id] || 0);
          if (numericValue > 0) habitStats[habit.id].active += 1;
          habitStats[habit.id].progress += Math.min(1, numericValue / habit.target);
          if (numericValue >= habit.target) { habitStats[habit.id].completed += 1; return sum + 1; }
          return sum;
        }, 0);
        const pomodoros = Number(record.pomodoro?.completed || 0);
        Object.entries(record.work?.timers || {}).forEach(([id, value]) => { categoryTotals[id] = (categoryTotals[id] || 0) + Number(value || 0); });
        if (Number(record.sideProject?.elapsed || 0) > 0) categoryTotals['side-project'] = (categoryTotals['side-project'] || 0) + Number(record.sideProject.elapsed || 0);
        dayStats.push({ date, key, workSeconds, habitCount, completedHabits, pomodoros, isActive: workSeconds > 0 || habitCount > 0 || pomodoros > 0 });
      }
      const bestDay = [...dayStats].filter((day) => day.isActive).sort((a, b) => (b.workSeconds + b.completedHabits * 900 + b.pomodoros * 1500) - (a.workSeconds + a.completedHabits * 900 + a.pomodoros * 1500))[0];
      const busiestDay = [...dayStats].filter((day) => day.workSeconds > 0).sort((a, b) => b.workSeconds - a.workSeconds)[0];
      const firstDayOffset = (new Date(year, month, 1, 12).getDay() + 6) % 7;
      const calendarCells = Array.from({ length: 42 }, (_, cellIndex) => {
        const dayNumber = cellIndex - firstDayOffset + 1;
        const date = new Date(year, month, dayNumber, 12);
        const inMonth = date.getMonth() === month;
        if (!inMonth) return `<article class="tracking-month-day is-muted"><strong>${date.getDate()}</strong></article>`;
        const stat = dayStats[dayNumber - 1];
        const record = getDayRecord(stat.key);
        const intensity = Math.min(4, Math.ceil((stat.workSeconds / 3600 + stat.habitCount + stat.pomodoros / 2) / 2));
        const dots = selectedHabits.map((habit) => Number(record.habits?.[habit.id] || 0) > 0 ? `<i class="tracking-month-habit-dot tracking-dot-${habit.tone}" title="${habit.name}"></i>` : '').join('');
        const isToday = stat.key === boardToday;
        const badge = stat.key === bestDay?.key && stat.workSeconds > 0 ? '<em>★</em>' : '';
        const calendarBody = `<div class="tracking-month-work-bars"><i></i><i></i><i></i><i></i><i></i></div><div class="tracking-month-dots">${dots || '<i class="tracking-month-habit-dot tracking-dot-none"></i>'}</div><small>🍅 ${stat.pomodoros}</small>`;
        const heatmapBody = `<span class="tracking-month-heatmap-score">${stat.workSeconds > 0 ? formatShortDuration(stat.workSeconds) : '—'}</span><small>${stat.habitCount} habits · 🍅 ${stat.pomodoros}</small>`;
        return `<article class="tracking-month-day${isToday ? ' is-today' : ''}" data-intensity="${intensity}"><strong>${dayNumber}</strong>${badge}<div class="tracking-month-calendar-body">${selectedMonthView === 'heatmap' ? heatmapBody : calendarBody}</div></article>`;
      }).join('');
      grid.classList.toggle('is-heatmap', selectedMonthView === 'heatmap');
      grid.innerHTML = calendarCells;
      panel.querySelector('[data-history-summary]').innerHTML = `<article><span>⏱️</span><div><small>TOTAL WORK HOURS</small><b>${formatShortDuration(workTotal)}</b><em>${formatSignedDuration(workTotal - previousAggregate.workTotal)}</em></div></article><article><span>💪</span><div><small>ACTIVE DAYS</small><b>${activeDays} / ${daysInMonth}</b><em>${formatSignedNumber(activeDays - previousAggregate.activeDays)} · ${Math.round((activeDays / daysInMonth) * 100)}% of month</em></div></article><article><span>📖</span><div><small>TOTAL HABIT COMPLETIONS</small><b>${habitTotal}</b><em>${formatSignedNumber(habitTotal - previousAggregate.habitTotal)} · ${selectedHabits.length} habits selected</em></div></article><article><span>🍅</span><div><small>AVG POMODOROS / DAY</small><b>${activeDays ? (pomodoroTotal / activeDays).toFixed(1) : '0.0'}</b><em>${formatSignedNumber(pomodoroTotal - previousAggregate.pomodoroTotal)} · 最佳日：${bestDay ? bestDay.date.getDate() : '—'} 日</em></div></article>`;
      const breakdown = panel.querySelector('[data-month-breakdown]');
      if (breakdown) {
        const workCategories = [...work.filter((item) => item.seconds !== undefined), { id: 'side-project', name: 'Side project', icon: '🌙' }];
        const knownCategoryIds = new Set(workCategories.map((item) => item.id));
        Object.keys(categoryTotals).filter((id) => !knownCategoryIds.has(id)).forEach((id) => workCategories.push({ id, name: id, icon: '💻' }));
        const maxWork = Math.max(...workCategories.map((category) => categoryTotals[category.id] || 0), 1);
        breakdown.innerHTML = workCategories.map((category) => { const value = categoryTotals[category.id] || 0; return `<div class="tracking-month-breakdown-row${value > 0 ? '' : ' is-empty'}"><span>${category.icon || '💻'}</span><div><strong>${category.name}</strong><i><b style="width:${Math.round((value / maxWork) * 100)}%"></b></i></div><em>${formatShortDuration(value)}</em><small>${value > 0 ? `${Math.round((value / Math.max(workTotal, 1)) * 100)}%` : '无记录'}</small></div>`; }).join('');
      }
      const habitBreakdown = panel.querySelector('[data-month-habit-breakdown]');
      if (habitBreakdown) habitBreakdown.innerHTML = selectedHabits.map((habit) => {
        const stats = habitStats[habit.id];
        const rate = stats.active ? Math.round((stats.progress / stats.active) * 100) : 0;
        return `<div class="tracking-month-habit-row"><span>${habit.icon}</span><strong>${habit.name}</strong><i>${Array.from({ length: 12 }, (_, index) => `<b class="${index < Math.round(rate / 100 * 12) ? `tracking-habit-block-${habit.tone}` : ''}"></b>`).join('')}</i><em>${rate}%</em></div>`;
      }).join('') || '<div class="tracking-empty-state">请选择至少一个习惯</div>';
      const insights = panel.querySelector('[data-month-insights]');
      if (insights) insights.innerHTML = `<article><strong>★</strong><small>BEST DAY</small><b>${bestDay ? bestDay.date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' }) : '—'}</b><span>${bestDay ? `${formatShortDuration(bestDay.workSeconds)} 工作` : '暂无数据'}</span></article><article><strong>◷</strong><small>BUSIEST DAY</small><b>${busiestDay ? busiestDay.date.toLocaleDateString('zh-CN', { weekday: 'long' }) : '—'}</b><span>${busiestDay ? formatShortDuration(busiestDay.workSeconds) : '暂无数据'}</span></article><article><strong>✓</strong><small>CONSISTENCY</small><b>${Math.round((activeDays / daysInMonth) * 100)}%</b><span>${activeDays} 个活跃日</span></article>`;
      const pomodoroSummary = panel.querySelector('[data-month-pomodoro-summary]');
      if (pomodoroSummary) pomodoroSummary.innerHTML = `<p><span>完成番茄钟</span><b>${pomodoroTotal}</b></p><p><span>平均每天</span><b>${activeDays ? (pomodoroTotal / activeDays).toFixed(1) : '0.0'}</b></p><p><span>最长工作日</span><b>${busiestDay ? busiestDay.date.getDate() + ' 日' : '—'}</b></p>`;
      const legend = panel.querySelector('[data-month-legend]');
      if (legend) legend.innerHTML = `<span><i class="tracking-month-legend-scale"></i>工作时长</span>${selectedHabits.map((habit) => `<span><i class="tracking-month-habit-dot tracking-dot-${habit.tone}"></i>${habit.name.replace('Read 10 pages', 'Read')}</span>`).join('')}`;
      const nextButton = panel.querySelector('[data-month-nav="next"]');
      if (nextButton) nextButton.disabled = selectedMonthOffset >= 0;
    }

    function renderLongTermView() {
      const panel = trackingBoard.querySelector('[data-tracking-view-panel="focus"]');
      if (!panel) return;
      const goals = historyState.longTerm?.goals || trackerState.longTerm?.goals || [];
      const counts = goals.reduce((result, goal) => { result[goal.status || 'active'] = (result[goal.status || 'active'] || 0) + 1; return result; }, {});
      const statusLabels = { active: 'ACTIVE', paused: 'PAUSED', completed: 'COMPLETED', archived: 'ARCHIVED' };
      const summaryItems = [
        ['total', 'TOTAL GOALS', goals.length, 'Total goals'],
        ['completed', 'COMPLETED', counts.completed || 0, 'Completed'],
        ['active', 'ACTIVE', counts.active || 0, 'Active'],
        ['paused', 'PAUSED', counts.paused || 0, 'Paused'],
        ['archived', 'ARCHIVED', counts.archived || 0, 'Archived'],
      ];
      const totalGoals = Math.max(goals.length, 1);
      panel.querySelector('[data-goal-summary]').innerHTML = summaryItems.map(([status, label, count, note]) => {
        const percentage = status === 'total' ? null : Math.round((count / totalGoals) * 100);
        return `<article class="tracking-goal-summary-card tracking-goal-summary-${status}"><span>${status === 'total' ? '🎯' : status === 'completed' ? '✓' : status === 'active' ? '⚡' : status === 'paused' ? 'Ⅱ' : '▣'}</span><div><small>${label}</small><b>${count}</b><em>${percentage === null ? note : `${percentage}% · ${note}`}</em></div></article>`;
      }).join('');
      const goalCard = (goal) => {
        const current = Number(goal.current || 0);
        const target = Number(goal.target || 0);
        const percentage = target > 0 ? Math.min(100, Math.round((current / target) * 100)) : 0;
        const status = goal.status || 'active';
        const targetDate = goal.targetDate || goal.deadline || 'Not set';
        const remaining = Math.max(0, target - current);
        const progressLabel = goal.progressLabelEn || 'Complete';
        const targetLabel = `${goal.unit || ''}${target.toLocaleString('zh-CN')}`;
        const remainingLabel = `${goal.unit || ''}${remaining.toLocaleString('zh-CN')}`;
        return `<article class="tracking-goal-card" data-goal-status="${status}"><span class="tracking-goal-icon">${goal.icon || '◆'}</span><div class="tracking-goal-main"><div class="tracking-goal-title"><strong>${goal.title}</strong><small>${statusLabels[status] || status}</small></div><div class="tracking-goal-values"><b>${goal.unit || ''}${current.toLocaleString('zh-CN')}</b><span>/ ${targetLabel}</span><em>${percentage}%</em></div><div class="tracking-goal-progress"><i style="width:${percentage}%"></i></div><div class="tracking-goal-meta"><span><small>TARGET</small><b>${targetLabel}</b></span><span><small>TARGET DATE</small><b>${targetDate}</b></span></div><div class="tracking-goal-footer">${goal.completedAt ? `Completed · ${goal.completedAt}` : `${progressLabel} · ${remainingLabel} to go`}</div></div></article>`;
      };
      const projectGoals = goals.filter((goal) => goal.type !== 'money' && !['completed', 'archived'].includes(goal.status));
      const moneyGoals = goals.filter((goal) => goal.type === 'money' && !['completed', 'archived'].includes(goal.status));
      const historyGoals = goals.filter((goal) => ['completed', 'archived'].includes(goal.status));
      const fill = (selector, items, emptyText) => { const target = panel.querySelector(selector); if (target) { target.dataset.goalCount = String(items.length); target.innerHTML = items.length ? items.map(goalCard).join('') : `<div class="tracking-empty-state">${emptyText}</div>`; } };
      fill('[data-goal-project-grid]', projectGoals, 'No active project goals yet');
      fill('[data-goal-money-grid]', moneyGoals, 'No active money goals yet');
      fill('[data-goal-history-grid]', historyGoals, 'Completed or archived goals will remain here');
      panel.querySelector('.tracking-project-goals')?.setAttribute('data-has-goals', String(projectGoals.length > 0));
      panel.querySelector('.tracking-money-goals')?.setAttribute('data-has-goals', String(moneyGoals.length > 0));
      panel.querySelector('.tracking-goal-history')?.setAttribute('data-has-goals', String(historyGoals.length > 0));
      const moneySummary = panel.querySelector('[data-money-summary]');
      const moneyGoalsList = goals.filter((goal) => goal.type === 'money');
      if (moneySummary) {
        const moneyRows = moneyGoalsList.map((goal) => {
          const current = Number(goal.current || 0);
          const target = Number(goal.target || 0);
          const percentage = target > 0 ? Math.min(100, Math.round((current / target) * 100)) : 0;
          return `<div class="tracking-money-summary-row"><span>${goal.icon || '💰'}</span><strong>${goal.unit || ''}${current.toLocaleString('zh-CN')} / ${goal.unit || ''}${target.toLocaleString('zh-CN')}</strong><small>${goal.label || goal.title} · ${goal.progressLabelEn || 'Progress'} <b>${percentage}%</b></small></div>`;
        }).join('');
        const activeMoneyGoals = moneyGoalsList.filter((goal) => goal.status === 'active').length;
        const pausedMoneyGoals = moneyGoalsList.filter((goal) => goal.status === 'paused').length;
        moneySummary.innerHTML = `${moneyRows || '<div class="tracking-empty-state">No money goals yet</div>'}<div class="tracking-money-summary-row tracking-money-summary-status"><span>✓</span><strong>${activeMoneyGoals}</strong><small>Active money goals · tracked separately</small></div><div class="tracking-money-summary-row tracking-money-summary-status"><span>Ⅱ</span><strong>${pausedMoneyGoals}</strong><small>Paused money goals</small></div>`;
      }
      const goalWeekDays = getWeekDays(selectedGoalWeekOffset);
      const goalWeekLabel = panel.querySelector('[data-goal-week-label]');
      if (goalWeekLabel) goalWeekLabel.textContent = `${dateKey(goalWeekDays[0])} — ${dateKey(goalWeekDays[6])}`;
      const goalNextButton = panel.querySelector('[data-goal-week-nav="next"]');
      if (goalNextButton) goalNextButton.disabled = selectedGoalWeekOffset >= 0;
      panel.querySelectorAll('[data-goal-status]').forEach((goal) => { goal.hidden = selectedGoalFilter !== 'all' && goal.dataset.goalStatus !== selectedGoalFilter; });
    }

    const trackingViewButtons = [...trackingBoard.querySelectorAll('[data-tracking-view]')];
    const trackingViewPanels = {
      cards: trackingBoard.querySelector('.tracking-board-body'),
      week: trackingBoard.querySelector('[data-tracking-view-panel="week"]'),
      month: trackingBoard.querySelector('[data-tracking-view-panel="month"]'),
      focus: trackingBoard.querySelector('[data-tracking-view-panel="focus"]')
    };
    function switchTrackingView(view) {
      Object.entries(trackingViewPanels).forEach(([key, panel]) => { if (panel) panel.hidden = key !== view; });
      trackingViewButtons.forEach((button) => button.classList.toggle('active', button.dataset.trackingView === view));
      const heading = trackingBoard.querySelector('[data-tracking-view-heading]');
      const headingTitle = heading?.querySelector('[data-tracking-view-heading-title]');
      const headingRange = heading?.querySelector('[data-tracking-view-heading-range]');
      const headingConfig = {
        cards: null,
        week: { title: 'WEEKLY REVIEW', range: `${getWeekDays().map(dateKey)[0]} — ${getWeekDays().map(dateKey)[6]}` },
        month: { title: 'MONTHLY TRENDS', range: new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(getMonthDate()) },
        focus: { title: 'LONG-TERM GOALS', range: 'Where do my long-term goals stand?' }
      }[view];
      if (heading && headingTitle && headingRange) {
        heading.hidden = !headingConfig;
        if (headingConfig) { headingTitle.textContent = headingConfig.title; headingRange.textContent = headingConfig.range; }
      }
      const clocks = trackingBoard.querySelector('.tracking-board-clock');
      if (clocks) clocks.hidden = view !== 'cards';
      if (view === 'week') renderWeekView();
      if (view === 'month') renderMonthView();
      if (view === 'focus') renderLongTermView();
    }
    trackingViewButtons.forEach((button) => button.addEventListener('click', () => switchTrackingView(button.dataset.trackingView)));
    trackingBoard.querySelectorAll('[data-week-nav]').forEach((button) => button.addEventListener('click', () => {
      if (button.dataset.weekNav === 'previous') selectedWeekOffset -= 1;
      if (button.dataset.weekNav === 'next') selectedWeekOffset = Math.min(0, selectedWeekOffset + 1);
      renderWeekView();
      const days = getWeekDays();
      const headingRange = trackingBoard.querySelector('[data-tracking-view-heading-range]');
      if (headingRange) headingRange.textContent = `${dateKey(days[0])} — ${dateKey(days[6])}`;
    }));
    trackingBoard.querySelectorAll('[data-goal-week-nav]').forEach((button) => button.addEventListener('click', () => {
      if (button.dataset.goalWeekNav === 'previous') selectedGoalWeekOffset -= 1;
      if (button.dataset.goalWeekNav === 'next') selectedGoalWeekOffset = Math.min(0, selectedGoalWeekOffset + 1);
      renderLongTermView();
    }));
    trackingBoard.querySelectorAll('[data-month-nav]').forEach((button) => button.addEventListener('click', () => {
      if (button.dataset.monthNav === 'previous') selectedMonthOffset -= 1;
      if (button.dataset.monthNav === 'next') selectedMonthOffset = Math.min(0, selectedMonthOffset + 1);
      renderMonthView();
      const headingRange = trackingBoard.querySelector('[data-tracking-view-heading-range]');
      if (headingRange) headingRange.textContent = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(getMonthDate());
    }));
    trackingBoard.querySelectorAll('[data-month-habit-filter]').forEach((input) => input.addEventListener('change', () => {
      const id = input.dataset.monthHabitFilter;
      if (input.checked) selectedMonthHabitIds.add(id); else selectedMonthHabitIds.delete(id);
      renderMonthView();
    }));
    trackingBoard.querySelectorAll('[data-month-view-option]').forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      selectedMonthView = input.value;
      renderMonthView();
    }));
    trackingBoard.querySelector('[data-week-export]')?.addEventListener('click', () => {
      const days = getWeekDays();
      const lines = [`# 熊窝 · 本周报告`, ``, `范围：${dateKey(days[0])} — ${dateKey(days[6])}`, ``];
      let workTotal = 0;
      let pomodoroTotal = 0;
      days.forEach((date) => {
        const record = getDayRecord(dateKey(date));
        const workSeconds = Object.values(record.work?.timers || {}).reduce((sum, value) => sum + Number(value || 0), 0) + Number(record.sideProject?.elapsed || 0);
        const pomodoros = Number(record.pomodoro?.completed || 0);
        const completed = habitDefinitions.filter((habit) => Number(record.habits?.[habit.id] || 0) >= habit.target).length;
        workTotal += workSeconds;
        pomodoroTotal += pomodoros;
        lines.push(`- ${dateKey(date)}：${formatWorkTime(workSeconds)} 工作，${pomodoros} 个番茄钟，${completed}/${habitDefinitions.length} 个习惯达成`);
      });
      lines.push(``, `总工作时长：${formatWorkTime(workTotal)}`, `番茄钟：${pomodoroTotal}`);
      const blob = new Blob([lines.join('\n')], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = `bear-home-weekly-${dateKey(days[0])}.md`;
      anchor.click();
      URL.revokeObjectURL(url);
    });
    trackingBoard.querySelectorAll('[data-goal-filter]').forEach((button) => button.addEventListener('click', () => {
      const filter = button.dataset.goalFilter;
      selectedGoalFilter = filter;
      trackingBoard.querySelectorAll('[data-goal-filter]').forEach((item) => item.classList.toggle('active', item === button));
      trackingBoard.querySelectorAll('[data-goal-status]').forEach((goal) => { goal.hidden = filter !== 'all' && goal.dataset.goalStatus !== filter; });
    }));
    trackingBoard.querySelector('[data-month-export]')?.addEventListener('click', () => {
      const monthDate = getMonthDate();
      const year = monthDate.getFullYear();
      const month = monthDate.getMonth();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const selectedHabits = habitDefinitions.filter((habit) => selectedMonthHabitIds.has(habit.id));
      const lines = [`# 熊窝 · 月度报告`, ``, `月份：${year}-${String(month + 1).padStart(2, '0')}`, ``];
      let workTotal = 0;
      let pomodoroTotal = 0;
      for (let index = 1; index <= daysInMonth; index += 1) {
        const date = new Date(year, month, index, 12);
        const stats = getDayStats(date);
        workTotal += stats.workSeconds;
        pomodoroTotal += stats.pomodoros;
        const completedHabits = selectedHabits.filter((habit) => Number(stats.record.habits?.[habit.id] || 0) >= habit.target).length;
        lines.push(`- ${stats.key}：${formatWorkTime(stats.workSeconds)} 工作，${stats.pomodoros} 个番茄钟，${completedHabits}/${selectedHabits.length} 个习惯达成`);
      }
      lines.push(``, `总工作时长：${formatWorkTime(workTotal)}`, `番茄钟：${pomodoroTotal}`);
      const blob = new Blob([lines.join('\n')], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = `bear-home-monthly-${year}-${String(month + 1).padStart(2, '0')}.md`;
      anchor.click();
      URL.revokeObjectURL(url);
    });
    trackingBoard.querySelector('[data-goal-export]')?.addEventListener('click', () => {
      const goals = historyState.longTerm?.goals || trackerState.longTerm?.goals || [];
      const lines = ['# 熊窝 · 长期目标', ''];
      goals.forEach((goal) => {
        const current = Number(goal.current || 0);
        const target = Number(goal.target || 0);
        const percentage = target > 0 ? Math.min(100, Math.round((current / target) * 100)) : 0;
        lines.push(`- ${goal.icon || '◆'} ${goal.title}：${current}/${target}（${percentage}%）· ${goal.status || 'active'}`);
      });
      const blob = new Blob([lines.join('\n')], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = 'bear-home-long-term-goals.md';
      anchor.click();
      URL.revokeObjectURL(url);
    });
    renderWeekView();
    renderMonthView();
    renderLongTermView();

    function checkDayBoundary() {
      const nextDay = currentTrackerDate();
      if (nextDay === boardToday) return;
      saveTracker();
      window.location.reload();
    }
    window.setInterval(checkDayBoundary, 60 * 1000);
    window.addEventListener('focus', checkDayBoundary);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) checkDayBoundary();
    });

  }
</script>
