---
import { routeCategories } from '../data/site.js';
---
<section class="route-table">
  <div class="route-search">
    <input data-route-search type="search" placeholder="搜索路由..." aria-label="搜索路由">
  </div>
  <div data-route-empty class="empty-state" hidden>没有匹配的路由</div>
  <div data-route-categories>
    {routeCategories.map((category) => (
      <section class="check-section open" data-route-category data-title={category.title} data-type={category.type ?? 'card'}>
        <button class="section-header" data-section-toggle type="button">
          <span class="section-header-left"><h2>{category.title}</h2></span>
          <span class="section-header-right"><span class="section-count">{category.items.length}</span><span class="section-arrow">▸</span></span>
        </button>
        <div class="section-body">
          <div class="pill-group">
            {category.type === 'icon' ? (
              category.items.map((item) => (
                <a href={item.url} target="_blank" rel="noopener" class="pill pill-icon" data-route-item data-search-text={item.name}>
                  <img src={`https://www.google.com/s2/favicons?domain=${new URL(item.url).hostname}&sz=64`} alt="" width="16" height="16">
                  <span>{item.name}</span>
                </a>
              ))
            ) : (
              category.items.map((item) => (
                item.url ? (
                  <a href={item.url} target="_blank" rel="noopener" class="pill" data-route-item data-search-text={`${item.name} ${item.desc ?? ''}`}>
                    <span>{item.name}</span>
                    {item.desc && <span class="pill-tip">{item.desc}</span>}
                  </a>
                ) : (
                  <div class="pill pill-static" data-route-item data-search-text={`${item.name} ${item.desc ?? ''}`}>
                    <span>{item.name}</span>
                    {item.path && <code class="pill-path">{item.path}</code>}
                    {item.desc && <span class="pill-tip">{item.desc}</span>}
                  </div>
                )
              ))
            )}
          </div>
        </div>
      </section>
    ))}
  </div>
</section>

<script is:inline>
  const routeSearch = document.querySelector('[data-route-search]');
  const routeEmpty = document.querySelector('[data-route-empty]');
  const routeCategories = [...document.querySelectorAll('[data-route-category]')];

  function filterRoutes() {
    const query = routeSearch.value.trim().toLowerCase();
    let visibleCount = 0;
    routeCategories.forEach((category) => {
      let categoryCount = 0;
      category.querySelectorAll('[data-route-item]').forEach((item) => {
        const visible = !query || item.dataset.searchText.toLowerCase().includes(query);
        item.hidden = !visible;
        if (visible) categoryCount += 1;
      });
      category.querySelector('.section-count').textContent = categoryCount;
      category.hidden = categoryCount === 0;
      visibleCount += categoryCount;
    });
    routeEmpty.hidden = visibleCount !== 0;
  }

  routeSearch?.addEventListener('input', filterRoutes);
  document.querySelectorAll('[data-section-toggle]').forEach((button) => {
    button.addEventListener('click', () => button.closest('[data-route-category]').classList.toggle('open'));
  });
</script>
