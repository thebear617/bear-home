---
import { githubProfile } from '../data/dashboard.js';
---
<article class="github-profile-card">
  <div class="github-profile-summary">
    <img src={githubProfile.avatarUrl} alt={`${githubProfile.displayName} 的 GitHub 头像`} width="56" height="56" loading="lazy">
    <div>
      <strong>{githubProfile.displayName}</strong>
      <a href={githubProfile.profileUrl} target="_blank" rel="noopener">@{githubProfile.username} ↗</a>
    </div>
    <span class="github-repo-count">{githubProfile.publicRepos} 个公开仓库</span>
  </div>
  <ul class="github-repo-list">
    {githubProfile.featuredRepos.map((repo) => (
      <li>
        <a href={`https://github.com/thebear617/${repo.name}`} target="_blank" rel="noopener">
          <span class="github-repo-icon" aria-hidden="true">⌘</span>
          <span><strong>{repo.name}</strong><small>{repo.description}</small></span>
          <span aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>
</article>
