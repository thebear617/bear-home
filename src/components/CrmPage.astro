---
import {
  CRM_CONTACTS,
  CRM_TODAY,
  dateDistance,
  followupBucket,
  getCrmStats,
  isLongNoContact,
} from '../data/crm-data';

const contacts = CRM_CONTACTS;
const selectedContact = contacts[0];
const stats = getCrmStats(contacts);

const statsConfig = [
  { id: 'contacts', label: '联系人总数', value: stats.total, tone: 'orange', icon: 'people' },
  { id: 'today', label: '今日待跟进', value: stats.today, tone: 'orange', icon: 'calendar' },
  { id: 'overdue', label: '已逾期跟进', value: stats.overdue, tone: 'red', icon: 'clock' },
  { id: 'weekly', label: '本周互动次数', value: stats.weeklyInteractions, tone: 'green', icon: 'heart' },
];

const smartFilters = [
  { id: 'all', label: '全部联系人', count: contacts.length, icon: 'people' },
  { id: 'today', label: '今日待跟进', count: stats.today, icon: 'calendar', tone: 'accent' },
  { id: 'new', label: '最近新增', count: 5, icon: 'spark' },
  { id: 'long', label: '长期未联系', count: contacts.filter(isLongNoContact).length, icon: 'clock' },
];

const relationshipTypes = ['家人', '朋友', '同学', '合作伙伴', '客户'];
const customTags = [
  { label: '合作伙伴', tone: 'peach' },
  { label: '猫猫项目', tone: 'sage' },
  { label: '设计', tone: 'blue' },
  { label: '咖啡', tone: 'sand' },
  { label: '摄影', tone: 'lilac' },
  { label: '产品', tone: 'yellow' },
  { label: '大学同学', tone: 'sage' },
  { label: '亲戚', tone: 'rose' },
];

const todayFollowups = contacts.filter((contact) => followupBucket(contact) === 'today');
const overdueFollowups = contacts.filter((contact) => followupBucket(contact) === 'overdue');
const next7Followups = contacts.filter((contact) => followupBucket(contact) === 'next7');
const reminderContacts = [...overdueFollowups, ...todayFollowups, ...next7Followups]
  .filter((contact, index, list) => list.findIndex((item) => item.id === contact.id) === index)
  .slice(0, 3);

const trendDays = [...new Set(contacts.flatMap((contact) => contact.interactions.map((interaction) => interaction.date)))]
  .sort()
  .slice(-8);
const trendValues = trendDays.map((date) => contacts.reduce(
  (total, contact) => total + contact.interactions.filter((interaction) => interaction.date === date).length,
  0,
));
const trendMax = Math.max(...trendValues, 1);
const trendCoordinates = trendValues.map((value, index) => ({
  x: 14 + (index * 272) / Math.max(trendValues.length - 1, 1),
  y: 78 - (value / trendMax) * 54,
}));
const trendPoints = trendCoordinates.map(({ x, y }) => `${x},${y}`).join(' ');
const trendAreaPath = `M ${trendCoordinates[0]?.x || 14} 86 L ${trendCoordinates.map(({ x, y }) => `${x} ${y}`).join(' L ')} L ${trendCoordinates.at(-1)?.x || 286} 86 Z`;

function relationshipCount(type: string): number {
  return contacts.filter((contact) => contact.relationshipType === type).length;
}

function tagCount(label: string): number {
  return contacts.filter((contact) => contact.tags.includes(label)).length;
}

function formatDate(value?: string): string {
  return value ? value.replaceAll('-', '.') : '—';
}

function followupText(contact: (typeof contacts)[number]): string {
  const bucket = followupBucket(contact);
  if (bucket === 'today') return '今天';
  if (bucket === 'overdue') {
    const distance = Math.abs(dateDistance(CRM_TODAY, contact.nextFollowUpAt) || 0);
    return `逾期 ${distance} 天`;
  }
  return formatDate(contact.nextFollowUpAt);
}

function followupTone(contact: (typeof contacts)[number]): string {
  const bucket = followupBucket(contact);
  return bucket === 'today' ? 'today' : bucket === 'overdue' ? 'overdue' : bucket === 'next7' ? 'next7' : 'normal';
}

function initials(contact: (typeof contacts)[number]): string {
  return contact.initials || contact.name.slice(0, 2);
}

function statusTone(status: string): string {
  return status === '良好' ? 'good' : status === '待维护' ? 'maintain' : 'normal';
}

function interactionTone(type: string): string {
  return type === '微信' ? 'wechat' : type === '邮件' ? 'mail' : type === '电话' ? 'phone' : type === '见面' ? 'meeting' : 'other';
}

function taskTone(status: string): string {
  return status === '进行中' ? 'doing' : status === '已完成' ? 'done' : 'todo';
}
---

<section class="crm-page" aria-labelledby="crm-page-title">
  <header class="crm-page-header">
    <div class="crm-header-row">
      <div class="crm-title-block">
        <h1 id="crm-page-title">关系管理</h1>
        <img class="crm-title-ornament" src="/assets/crm/crm-title-ornament.png" alt="" width="107" height="40" loading="eager" />
      </div>

      <div class="crm-header-decoration" aria-hidden="true">
        <img src="/assets/crm/crm-header-illustration.png?v=sunrise" alt="" width="2172" height="724" loading="eager" />
      </div>
    </div>
  </header>

  <section class="crm-overview-dashboard-row" data-crm-overview-row aria-label="关系管理概览看板">
    <article class="crm-overview-card crm-activity-trend-card">
      <div class="crm-overview-card-heading">
        <div>
          <h2 class="crm-overview-title"><span class="crm-overview-title-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4.5 17.5 9.2 12.8l3.2 3.1 6.8-7.4"></path><path d="M15.5 8.5h3.7v3.7"></path></svg></span>关系活跃度趋势</h2>
        </div>
        <button class="crm-overview-card-action crm-overview-entry-button" type="button" data-crm-view-dashboard>数据看板</button>
      </div>
      <div class="crm-trend-chart" aria-label="关系活跃度趋势">
        <svg viewBox="0 0 300 100" role="img" aria-label="关系活跃度折线图" preserveAspectRatio="none">
          <defs>
            <linearGradient id="crm-trend-fill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="#ef7b37" stop-opacity=".28" />
              <stop offset="1" stop-color="#ef7b37" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path d={trendAreaPath} fill="url(#crm-trend-fill)" />
          <polyline points={trendPoints} fill="none" stroke="#e96b2c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          {trendCoordinates.map(({ x, y }) => <circle cx={x} cy={y} r="2.8" fill="#e96b2c" stroke="#fffdf8" stroke-width="1.5" />)}
        </svg>
        <div class="crm-trend-labels">
          {trendDays.map((date) => <span>{date.slice(5).replace('-', '/')}</span>)}
        </div>
      </div>
    </article>

    <article class="crm-overview-card crm-reminder-overview-card">
      <div class="crm-overview-card-heading">
        <div>
          <h2 class="crm-overview-title"><span class="crm-overview-title-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M6.5 17.5h11l-1.2-1.8V11a4.3 4.3 0 0 0-8.6 0v4.7Z"></path><path d="M9.5 19.5h5"></path></svg></span>近期提醒</h2>
        </div>
        <button class="crm-overview-card-action crm-subtle-link" type="button" data-crm-view-followups>查看全部</button>
      </div>
      <ul class="crm-reminder-list">
        {reminderContacts.map((contact) => (
          <li>
            <span class:list={['crm-reminder-dot', `is-${followupTone(contact)}`]} aria-hidden="true"></span>
            <time datetime={contact.nextFollowUpAt}>{formatDate(contact.nextFollowUpAt)}</time>
            <strong>{contact.name}</strong>
            <span class="crm-reminder-status">{followupText(contact)}</span>
            <p data-crm-tooltip={contact.notes}>{contact.notes.split('\n')[0]}</p>
          </li>
        ))}
      </ul>
    </article>

    <article class="crm-overview-card crm-quote-overview-card">
      <img class="crm-quote-overview-art" src="/assets/crm/container-placeholder-illustration.png?v=crm-container-v1" alt="重要的不是认识多少人，而是把重要的人一直放在生活里" width="2080" height="756" loading="lazy" />
    </article>
  </section>

  <section class="crm-workspace" aria-label="关系管理工作区">
    <section class="crm-left-column" data-crm-view-panel="contacts" aria-label="联系人列表工作台">
      <section class="crm-address-book-panel crm-panel-card" aria-label="联系簿">
        <div class="crm-mobile-filter-bar" data-crm-mobile-filter-bar aria-label="移动端筛选">
          <button class="crm-primary-button crm-mobile-add-contact" type="button" data-crm-add-contact>
            <span aria-hidden="true">＋</span>
            新增
          </button>
          <button class="crm-mobile-filter-trigger" type="button" data-crm-mobile-filter-sheet aria-expanded="false">
            <span aria-hidden="true">☷</span>
            筛选
          </button>
          <div class="crm-mobile-filter-chips" data-crm-mobile-filter-chips aria-label="快速筛选"></div>
        </div>
        <div class="crm-mobile-filter-scrim" data-crm-mobile-filter-close hidden></div>

        <div class="crm-left-list-layout">

    <aside class="crm-sidebar-panel crm-panel-card" aria-label="联系人筛选">

      <div class="crm-filter-switcher" role="tablist" aria-label="筛选分类">
        <button class="is-active" type="button" role="tab" aria-selected="true" data-crm-filter-panel="smart">智能筛选</button>
        <button type="button" role="tab" aria-selected="false" data-crm-filter-panel="relationship">关系类型</button>
        <button type="button" role="tab" aria-selected="false" data-crm-filter-panel="tags">标签筛选</button>
      </div>

      <section class="crm-filter-group" data-crm-filter-panel-content="smart" aria-labelledby="crm-smart-filter-title">
        <h3 id="crm-smart-filter-title">智能筛选</h3>
        <div class="crm-filter-list">
          {smartFilters.map((filter, index) => (
            <button class:list={['crm-filter-row', { 'is-active': index === 0 }, `is-${filter.tone || 'default'}`]} type="button" data-crm-filter={filter.id}>
              <span class="crm-filter-icon" aria-hidden="true">
                {filter.icon === 'people' && <svg viewBox="0 0 24 24" focusable="false"><circle cx="9" cy="8" r="3"></circle><path d="M3.5 19c.4-3.1 2.2-4.7 5.5-4.7"></path><path d="M16 7a2.3 2.3 0 0 1 0 4.5"></path></svg>}
                {filter.icon === 'calendar' && <svg viewBox="0 0 24 24" focusable="false"><rect x="4" y="5.5" width="16" height="15" rx="2"></rect><path d="M8 3.5v4M16 3.5v4M4 10h16"></path></svg>}
                {filter.icon === 'spark' && <svg viewBox="0 0 24 24" focusable="false"><path d="m12 3 1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6L12 3Z"></path><path d="m19 16 .7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z"></path></svg>}
                {filter.icon === 'clock' && <svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="8"></circle><path d="M12 7v5l3 2"></path></svg>}
              </span>
              <span>{filter.label}</span>
              <b data-crm-filter-count={filter.id}>{filter.count}</b>
            </button>
          ))}
        </div>
      </section>

      <section class="crm-filter-group crm-relationship-group" data-crm-filter-panel-content="relationship" aria-labelledby="crm-relationship-title" hidden>
        <h3 id="crm-relationship-title">关系类型</h3>
        <div class="crm-filter-list">
          {relationshipTypes.map((type) => (
            <button class="crm-filter-row" type="button" data-crm-relationship={type}>
              <span class="crm-filter-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><rect x="5" y="5" width="14" height="14" rx="3"></rect><path d="M9 5v14"></path></svg></span>
              <span>{type}</span>
              <b data-crm-relationship-count={type}>{relationshipCount(type)}</b>
            </button>
          ))}
        </div>
      </section>

      <section class="crm-filter-group crm-tag-group" data-crm-filter-panel-content="tags" aria-labelledby="crm-tag-title" hidden>
        <div class="crm-tag-heading">
          <h3 id="crm-tag-title">标签筛选</h3>
          <button class="crm-tag-add" type="button" data-crm-add-tag aria-label="添加标签">＋</button>
        </div>
        <div class="crm-tag-list">
          {customTags.map((tag) => (
            <button class:list={['crm-tag-row', `is-${tag.tone}`]} type="button" data-crm-tag={tag.label}>
              <span class="crm-tag-dot" aria-hidden="true"></span>
              <span>{tag.label}</span>
              <b>{tagCount(tag.label)}</b>
            </button>
          ))}
        </div>
      </section>

      <div class="crm-sidebar-illustration">
        <img class="crm-sidebar-bear" src="/assets/crm/sidebar-bear.png" alt="" width="160" height="152" loading="lazy" />
      </div>
    </aside>

    <section class="crm-center-column" aria-labelledby="crm-contact-title">
      <section class="crm-contact-panel crm-panel-card">
        <div class="crm-content-heading">
          <div>
            <p class="crm-panel-kicker">PEOPLE IN YOUR CIRCLE</p>
            <h2 id="crm-contact-title" data-crm-list-title>联系人 <span data-crm-contact-count>{contacts.length}</span></h2>
          </div>
          <div class="crm-content-heading-actions">
            <button class="crm-primary-button" type="button" data-crm-add-contact>
              <span aria-hidden="true">＋</span>
              新增联系人
            </button>
          </div>
        </div>

        <div class="crm-contact-toolbar" aria-label="联系人列表工具栏">
          <label class="crm-list-search">
            <span class="crm-search-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="10.8" cy="10.8" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg></span>
            <span class="sr-only">搜索联系人</span>
            <input type="search" placeholder="搜索联系人" aria-label="搜索联系人" />
          </label>
          <div class="crm-toolbar-menu-wrap">
            <button class="crm-select-button" type="button" data-crm-tag-filter aria-haspopup="menu" aria-expanded="false">全部标签 <span aria-hidden="true">⌄</span></button>
            <div class="crm-toolbar-menu" data-crm-tag-menu role="menu" hidden>
              <button type="button" role="menuitem" data-crm-menu-tag="">全部标签</button>
              {customTags.map((tag) => <button type="button" role="menuitem" data-crm-menu-tag={tag.label}>{tag.label}</button>)}
            </div>
          </div>
          <div class="crm-toolbar-menu-wrap">
            <button class="crm-select-button" type="button" data-crm-sort aria-haspopup="menu" aria-expanded="false">按最近联系 <span aria-hidden="true">⌄</span></button>
            <div class="crm-toolbar-menu" data-crm-sort-menu role="menu" hidden>
              <button type="button" role="menuitem" data-crm-menu-sort="recent">按最近联系</button>
              <button type="button" role="menuitem" data-crm-menu-sort="followup">按下次跟进</button>
              <button type="button" role="menuitem" data-crm-menu-sort="importance">按重要程度</button>
            </div>
          </div>
        </div>

        <div class="crm-contact-column-heading" aria-hidden="true">
          <span>联系人</span>
          <span>关系类型</span>
          <span>关系热度</span>
          <span>上次联系</span>
          <span>下次提醒</span>
        </div>

        <div class="crm-filter-summary" data-crm-filter-summary hidden>
          <span data-crm-filter-summary-text></span>
          <button type="button" data-crm-clear-filters>清空筛选</button>
        </div>

        <div class="crm-contact-list is-compact" data-crm-contact-list>
          {contacts.map((contact, index) => (
            <article class:list={['crm-contact-card', { 'is-selected': index === 0 }, { 'is-long-no-contact': isLongNoContact(contact) }]} data-contact-id={contact.id} aria-selected={index === 0 ? 'true' : 'false'} role="button" tabindex="0">
              <div class="crm-contact-main">
                <span class:list={['crm-contact-avatar', `tone-${contact.avatarTone}`]} aria-hidden="true">{initials(contact)}</span>
                <div class="crm-contact-copy">
                  <div class="crm-contact-name-row">
                    <h3>{contact.name}</h3>
                    <span class="crm-contact-role">{contact.role}</span>
                  </div>
                  <p class="crm-contact-note">{contact.notes.split('\n')[0]}</p>
                </div>
                <div class="crm-contact-relation">
                  <span class:list={['crm-badge', `relationship-${contact.relationshipType}`]}>{contact.relationshipType}</span>
                  {contact.tags.slice(1, 2).map((tag) => <span class="crm-badge is-soft-green">{tag}</span>)}
                </div>
                <div class="crm-contact-heat" aria-label={`重要度 ${contact.importance} 星`}><b>{'♥'.repeat(contact.importance)}</b></div>
                <div class="crm-contact-dates">
                  <span>最近联系 <b>{formatDate(contact.lastContactAt)}</b></span>
                  <span>下次跟进 <b class:list={[`is-${followupTone(contact)}`]}>{followupText(contact)}</b></span>
                </div>
              </div>
              <div class="crm-contact-bottomline">
                <span class:list={['crm-status-badge', `is-${statusTone(contact.relationshipStatus)}`]}>{contact.relationshipStatus}</span>
                <span class="crm-contact-importance">重要度 <b>{'♥'.repeat(contact.importance)}</b></span>
                <div class="crm-contact-actions" aria-label={`${contact.name}快捷操作`}>
                  <button type="button" data-crm-log-interaction={contact.id}>▧ 记录互动</button>
                  <button type="button" data-crm-followup={contact.id}>◷ 安排跟进</button>
                  <button type="button" data-crm-edit-contact={contact.id}>⌕ 编辑</button>
                </div>
              </div>
            </article>
          ))}
          <div class="crm-list-empty" data-crm-list-empty hidden>
            <strong>没有找到匹配的联系人</strong>
            <span>试试清空筛选，或换一个关键词。</span>
            <button type="button" data-crm-clear-filters>清空筛选</button>
          </div>
        </div>

        <nav class="crm-pagination" data-crm-pagination aria-label="联系人分页" hidden>
          <button type="button" data-crm-page-prev aria-label="上一页">‹</button>
          <div class="crm-pagination-pages" data-crm-page-items></div>
          <button type="button" data-crm-page-next aria-label="下一页">›</button>
          <span class="crm-pagination-status" data-crm-page-status>1 / 1</span>
        </nav>
      </section>

    </section>
        </div>
      </section>
    </section>

    <div class="crm-mobile-detail-scrim" data-crm-mobile-detail-close hidden></div>
    <aside class="crm-detail-column crm-panel-card" data-crm-view-panel="contacts" aria-labelledby="crm-detail-title">
      <button class="crm-mobile-detail-close" type="button" data-crm-mobile-detail-close aria-label="关闭联系人详情">×</button>
      <article class="crm-detail-card crm-panel-card" data-crm-detail-content>
        <div class="crm-detail-hero">
          <header class="crm-detail-identity">
            <span class:list={['crm-detail-avatar', `tone-${selectedContact.avatarTone}`]} aria-hidden="true">{initials(selectedContact)}</span>
            <div class="crm-detail-name">
              <div class="crm-detail-name-heading">
                <h2 id="crm-detail-title">{selectedContact.name}</h2>
                <span class="crm-detail-favorite" aria-label={`重要度 ${selectedContact.importance} 星`}>★</span>
              </div>
              <p>{selectedContact.role} · {selectedContact.organization}</p>
              <p class="crm-detail-intro">{selectedContact.notes.split('\n')[0]}</p>
            </div>
            <button class="crm-detail-edit" type="button" data-crm-edit-contact={selectedContact.id} aria-label={`编辑${selectedContact.name}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5.5 4 4M5 19l3.8-.8L19.3 7.7a2.1 2.1 0 0 0-3-3L5.8 15.2Z"></path></svg>
              编辑
            </button>
          </header>
          <aside class="crm-detail-note-card" aria-label="关系提醒"><img src="/assets/crm/detail-note.png" alt="和有趣的人一起，让生活更有趣" width="1375" height="1144" loading="eager" /></aside>
        </div>

        <div class="crm-detail-tags-row">
          <div class="crm-contact-tags">
            <span class="crm-badge relationship-合作伙伴">{selectedContact.relationshipType}</span>
            {selectedContact.tags.filter((tag) => tag !== selectedContact.relationshipType).map((tag, index) => <span class:list={['crm-badge', { 'is-soft-green': index === 0, 'is-soft-blue': index === 1 }]}>{tag}</span>)}
          </div>
        </div>

        <section class="crm-detail-info-card" aria-label="联系人信息">
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6.5 4.5 9 4l1.7 4.1-1.8 1.3a13 13 0 0 0 5.7 5.7l1.3-1.8L20 15l-.5 2.5c-.3 1.5-1.8 2.3-3.2 1.8A16.2 16.2 0 0 1 4.7 7.7C4.2 6.3 5 4.8 6.5 4.5Z"></path></svg></span><span class="crm-detail-info-label">手机</span><strong>{selectedContact.phone}</strong><button class="crm-detail-copy" type="button" data-crm-copy={selectedContact.phone} aria-label="复制手机号"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg></button></div>
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 8.5h14M6.5 5h11A2.5 2.5 0 0 1 20 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5v-9A2.5 2.5 0 0 1 6.5 5Z"></path><path d="M8 12h.01M12 12h.01M16 12h.01M8 15.5h.01M12 15.5h.01M16 15.5h.01"></path></svg></span><span class="crm-detail-info-label">关系</span><strong>{selectedContact.relationshipType}</strong><span class="crm-detail-info-action" aria-hidden="true"></span></div>
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5.5" width="16" height="13" rx="2"></rect><path d="m5 7 7 5 7-5"></path></svg></span><span class="crm-detail-info-label">邮箱</span><strong>{selectedContact.email}</strong><button class="crm-detail-copy" type="button" data-crm-copy={selectedContact.email} aria-label="复制邮箱"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg></button></div>
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 19.5V6.8A1.8 1.8 0 0 1 6.8 5h10.4A1.8 1.8 0 0 1 19 6.8v12.7H5Z"></path><path d="M8.5 9h7M8.5 12.5h7M8.5 16h4"></path></svg></span><span class="crm-detail-info-label">身份</span><strong>{selectedContact.role} · {selectedContact.organization}</strong><span class="crm-detail-info-action" aria-hidden="true"></span></div>
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5.5" width="16" height="15" rx="2"></rect><path d="M8 3.5v4M16 3.5v4M4 10h16"></path></svg></span><span class="crm-detail-info-label">最近联系</span><strong>{formatDate(selectedContact.lastContactAt)}</strong><span class="crm-detail-info-action" aria-hidden="true"></span></div>
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4.5h12v15H6z"></path><path d="M8.5 9h7M8.5 12.5h5M8.5 16h4"></path></svg></span><span class="crm-detail-info-label">备注</span><strong>{selectedContact.notes.split('\n')[0]}</strong><button class="crm-detail-info-action crm-detail-edit-note" type="button" data-crm-edit-contact={selectedContact.id} aria-label="编辑备注"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 19 3.3-.7L18.5 8.1a2 2 0 0 0-2.8-2.8L5.5 15.5Z"></path></svg></button></div>
