<script define:vars={{ crmContacts: contacts, crmToday: CRM_TODAY }}>
  const root = document.querySelector('.crm-page');

  if (root) {
    const tooltipTargetSelector = '[data-crm-tooltip]';
    const hoverTooltip = document.createElement('div');
    hoverTooltip.className = 'crm-floating-tooltip';
    hoverTooltip.setAttribute('role', 'tooltip');
    hoverTooltip.hidden = true;
    document.body.append(hoverTooltip);
    let activeTooltipTarget = null;

    const hideTooltip = () => {
      activeTooltipTarget = null;
      hoverTooltip.classList.remove('is-visible');
      hoverTooltip.hidden = true;
    };

    const positionTooltip = (target) => {
      if (!target || hoverTooltip.hidden) return;
      const targetRect = target.getBoundingClientRect();
      const tooltipRect = hoverTooltip.getBoundingClientRect();
      const gap = 8;
      const edge = 12;
      let left = targetRect.left + (targetRect.width - tooltipRect.width) / 2;
      left = Math.max(edge, Math.min(left, window.innerWidth - tooltipRect.width - edge));
      let top = targetRect.top - tooltipRect.height - gap;
      if (top < edge) top = targetRect.bottom + gap;
      hoverTooltip.style.left = `${Math.round(left)}px`;
      hoverTooltip.style.top = `${Math.round(top)}px`;
    };

    const showTooltip = (target) => {
      const text = target?.dataset.crmTooltip?.trim();
      if (!text) return;
      if (target.scrollWidth <= target.clientWidth + 1 && target.scrollHeight <= target.clientHeight + 1) return;
      activeTooltipTarget = target;
      hoverTooltip.textContent = text;
      hoverTooltip.hidden = false;
      hoverTooltip.classList.add('is-visible');
      positionTooltip(target);
    };

    root.addEventListener('pointerover', (event) => {
      const source = event.target;
      if (!(source instanceof Element)) return;
      const target = source.closest(tooltipTargetSelector);
      if (!target || !root.contains(target)) return;
      if (event.relatedTarget instanceof Node && target.contains(event.relatedTarget)) return;
      showTooltip(target);
    });

    root.addEventListener('pointerout', (event) => {
      const source = event.target;
      if (!(source instanceof Element)) return;
      const target = source.closest(tooltipTargetSelector);
      if (!target || activeTooltipTarget !== target) return;
      if (event.relatedTarget instanceof Node && target.contains(event.relatedTarget)) return;
      hideTooltip();
    });

    window.addEventListener('scroll', hideTooltip, true);
    window.addEventListener('resize', hideTooltip);

    const contacts = crmContacts;
    const state = {
      query: '',
      smart: 'all',
      relationship: '',
      tag: '',
      sort: 'recent',
      primaryView: 'contacts',
      page: 1,
      filterPanel: 'smart',
      selectedId: contacts[0]?.id || '',
    };

    const pageSize = 7;
    const primaryViews = ['contacts', 'dashboard'];
    const primaryViewTitles = {
      contacts: '联系人',
      dashboard: '关系数据看板',
    };

    const readPrimaryView = () => {
      const view = new URLSearchParams(window.location.search).get('view');
      return primaryViews.includes(view) ? view : 'contacts';
    };

    state.primaryView = readPrimaryView();

    const query = (selector) => root.querySelector(selector);
    const queryAll = (selector) => [...root.querySelectorAll(selector)];
    const list = query('[data-crm-contact-list]');
    let contactCards = queryAll('.crm-contact-card');
    const emptyState = query('[data-crm-list-empty]');
    const detail = query('[data-crm-detail-content]');
    const detailActivity = query('[data-crm-detail-activity]');
    const mobileFilterChips = query('[data-crm-mobile-filter-chips]');
    const mobileFilterScrim = query('.crm-mobile-filter-scrim');
    const mobileDetailScrim = query('.crm-mobile-detail-scrim');
    const mobileFilterTrigger = query('[data-crm-mobile-filter-sheet]');
    const mobileFilterClose = query('.crm-mobile-filter-close');
    const mobileDetailClose = query('.crm-mobile-detail-close');
    const relatedTasks = query('.crm-related-tasks');
    const leftColumn = query('.crm-left-column');
    const detailColumn = query('.crm-detail-column');
    const contactPanel = query('.crm-contact-panel');
    const centerColumn = query('.crm-center-column');
    const followupBoard = query('.crm-followup-board');
    const noFollowups = query('[data-crm-no-followups]');
    const timelinePanel = query('[data-crm-timeline-view]');
    const dashboardRow = query('[data-crm-dashboard-row]');
    const timelineList = query('[data-crm-global-timeline]');
    const overviewRow = query('[data-crm-overview-row]');
    const listTitle = query('[data-crm-list-title]');
    const contactCount = query('[data-crm-contact-count]');
    const timelineCount = query('[data-crm-timeline-count]');
    const dashboardTitle = query('[data-crm-dashboard-title]');
    const dashboardKicker = query('[data-crm-dashboard-kicker]');
    const summary = query('[data-crm-filter-summary]');
    const summaryText = query('[data-crm-filter-summary-text]');
    const pagination = query('[data-crm-pagination]');
    const paginationItems = query('[data-crm-page-items]');
    const paginationStatus = query('[data-crm-page-status]');
    const paginationPrevious = query('[data-crm-page-prev]');
    const paginationNext = query('[data-crm-page-next]');
    const workspace = query('.crm-workspace');
    const searchInputs = queryAll('.crm-search-field input, .crm-list-search input');
    const overlay = document.querySelector('[data-crm-overlay]');
    const surfaces = [...document.querySelectorAll('[data-crm-surface]')];
    const toast = document.querySelector('[data-crm-toast]');
    const toastMessage = document.querySelector('[data-crm-toast-message]');
    const contactForm = document.querySelector('[data-crm-contact-form]');
    const contactFormTitle = document.querySelector('[data-crm-contact-form-title]');
    const contactSubmit = document.querySelector('[data-crm-contact-submit]');
    const contactFormError = document.querySelector('[data-crm-contact-form-error]');
    const interactionForm = document.querySelector('[data-crm-interaction-form]');
    const interactionContact = document.querySelector('[data-crm-interaction-contact]');
    const followupForm = document.querySelector('[data-crm-followup-form]');
    const followupContact = document.querySelector('[data-crm-followup-contact]');
    let activeSurfaceContactId = state.selectedId;
    let selectedInteractionType = '微信';
    let toastTimer;

    const escapeHtml = (value = '') => String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

    const dateValue = (value = '') => {
      const time = Date.parse(`${value}T12:00:00+08:00`);
      return Number.isFinite(time) ? time : Number.NaN;
    };

    const dateDistance = (from, to) => {
      const difference = dateValue(to) - dateValue(from);
      return Number.isFinite(difference) ? Math.round(difference / 86400000) : null;
    };

    const followupBucket = (contact) => {
      const distance = dateDistance(crmToday, contact.nextFollowUpAt);
      if (distance === 0) return 'today';
      if (distance !== null && distance < 0) return 'overdue';
      if (distance !== null && distance <= 7) return 'next7';
      return 'none';
    };

    const isLongNoContact = (contact) => {
      const distance = dateDistance(contact.lastContactAt || crmToday, crmToday);
      return distance !== null && distance >= 45;
    };

    const isRecentlyAdded = (contact) => {
      const distance = dateDistance(contact.createdAt, crmToday);
      return distance !== null && distance >= 0 && distance <= 30;
    };

    const formatDate = (value) => value ? value.replaceAll('-', '.') : '—';

    const statusTone = (status) => status === '良好' ? 'good' : status === '待维护' ? 'maintain' : 'normal';
    const interactionTone = (type) => type === '微信' ? 'wechat' : type === '邮件' ? 'mail' : type === '电话' ? 'phone' : type === '见面' ? 'meeting' : 'other';
    const taskTone = (status) => status === '进行中' ? 'doing' : status === '已完成' ? 'done' : 'todo';
    const followupText = (contact) => {
      const bucket = followupBucket(contact);
      if (bucket === 'today') return '今天';
      if (bucket === 'overdue') return `逾期 ${Math.abs(dateDistance(crmToday, contact.nextFollowUpAt) || 0)} 天`;
      return formatDate(contact.nextFollowUpAt);
    };
    const followupTone = (contact) => {
      const bucket = followupBucket(contact);
      return bucket === 'today' ? 'today' : bucket === 'overdue' ? 'overdue' : bucket === 'next7' ? 'next7' : 'normal';
    };
    const initials = (contact) => contact.initials || contact.name.slice(0, 2);

    const renderContactCardMarkup = (contact) => {
      const secondaryTag = contact.tags?.[1] || '';
      const longBadge = isLongNoContact(contact) ? '<span class="crm-long-badge">超过 45 天未联系</span>' : '';
      return `<article class="crm-contact-card${contact.id === state.selectedId ? ' is-selected' : ''}${isLongNoContact(contact) ? ' is-long-no-contact' : ''}" data-contact-id="${escapeHtml(contact.id)}" aria-selected="${contact.id === state.selectedId}" role="button" tabindex="0">
        <div class="crm-contact-main">
          <span class="crm-contact-avatar tone-${escapeHtml(contact.avatarTone)}" aria-hidden="true">${escapeHtml(initials(contact))}</span>
          <div class="crm-contact-copy">
            <div class="crm-contact-name-row"><h3>${escapeHtml(contact.name)}</h3><span class="crm-contact-role">${escapeHtml(contact.role || '未填写身份')}</span></div>
            <p class="crm-contact-note">${escapeHtml((contact.notes || '还没有备注').split('\n')[0])}</p>
          </div>
          <div class="crm-contact-relation">${relationshipBadge(contact)}${secondaryTag ? `<span class="crm-badge is-soft-green">${escapeHtml(secondaryTag)}</span>` : ''}${longBadge}</div>
          <div class="crm-contact-heat" aria-label="重要度 ${contact.importance} 星"><b>${'♥'.repeat(contact.importance)}</b></div>
          <div class="crm-contact-dates">
            <span>最近联系 <b>${formatDate(contact.lastContactAt)}</b></span>
            <span>下次跟进 <b class="is-${followupTone(contact)}">${followupText(contact)}</b></span>
          </div>
        </div>
        <div class="crm-contact-bottomline">
          <span class="crm-status-badge is-${statusTone(contact.relationshipStatus)}">${escapeHtml(contact.relationshipStatus)}</span>
          <span class="crm-contact-importance">重要度 <b>${'♥'.repeat(contact.importance)}</b></span>
          <div class="crm-contact-actions" aria-label="${escapeHtml(contact.name)}快捷操作">
            <button type="button" data-crm-log-interaction="${escapeHtml(contact.id)}">▧ 记录互动</button>
            <button type="button" data-crm-followup="${escapeHtml(contact.id)}">◷ 安排跟进</button>
            <button type="button" data-crm-edit-contact="${escapeHtml(contact.id)}">⌕ 编辑</button>
          </div>
        </div>
      </article>`;
    };

    const rebuildContactCards = () => {
      if (!list || !emptyState) return;
      contactCards.forEach((card) => card.remove());
      contacts.forEach((contact) => list.insertBefore(
        document.createRange().createContextualFragment(renderContactCardMarkup(contact)).firstElementChild,
        emptyState,
      ));
      contactCards = queryAll('.crm-contact-card');
    };

    const matchesQuery = (contact) => {
      const keyword = state.query.trim().toLocaleLowerCase();
      if (!keyword) return true;
      return [contact.name, contact.organization, contact.role, contact.notes, ...(contact.tags || [])]
        .filter(Boolean)
        .join(' ')
        .toLocaleLowerCase()
        .includes(keyword);
    };

    const matchesFilter = (contact) => {
      if (!matchesQuery(contact)) return false;
      if (state.relationship && contact.relationshipType !== state.relationship) return false;
      if (state.tag && !(contact.tags || []).includes(state.tag)) return false;
      if (state.smart === 'today' && followupBucket(contact) !== 'today') return false;
      if (state.smart === 'new' && !isRecentlyAdded(contact)) return false;
      if (state.smart === 'long' && !isLongNoContact(contact)) return false;
      return true;
    };

    const sortContacts = (items) => [...items].sort((first, second) => {
      if (state.sort === 'importance') {
        return second.importance - first.importance
          || (dateValue(second.lastContactAt) || 0) - (dateValue(first.lastContactAt) || 0);
      }
      if (state.sort === 'followup') {
        const firstDate = dateValue(first.nextFollowUpAt);
        const secondDate = dateValue(second.nextFollowUpAt);
        if (!Number.isFinite(firstDate) && !Number.isFinite(secondDate)) return 0;
        if (!Number.isFinite(firstDate)) return 1;
        if (!Number.isFinite(secondDate)) return -1;
        return firstDate - secondDate;
      }
      return (dateValue(second.lastContactAt) || 0) - (dateValue(first.lastContactAt) || 0);
    });

    const getVisibleContacts = () => {
      return contacts.filter(matchesFilter);
    };

    const setFilterPanel = (panel) => {
      const nextPanel = ['smart', 'relationship', 'tags'].includes(panel) ? panel : 'smart';
      state.filterPanel = nextPanel;
      queryAll('[data-crm-filter-panel]').forEach((button) => {
        const isActive = button.dataset.crmFilterPanel === nextPanel;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-selected', String(isActive));
      });
      queryAll('[data-crm-filter-panel-content]').forEach((section) => {
        section.hidden = section.dataset.crmFilterPanelContent !== nextPanel;
      });
    };

    const renderPagination = (total) => {
      if (!pagination) return;
      const totalPages = Math.max(1, Math.ceil(total / pageSize));
      state.page = Math.min(Math.max(1, state.page), totalPages);
      pagination.hidden = total <= pageSize;
      if (paginationItems) {
        paginationItems.innerHTML = Array.from({ length: totalPages }, (_, index) => {
          const page = index + 1;
          return `<button type="button" data-crm-page="${page}" aria-label="第 ${page} 页"${page === state.page ? ' aria-current="page"' : ''}>${page}</button>`;
        }).join('');
      }
      if (paginationPrevious) paginationPrevious.disabled = state.page <= 1;
      if (paginationNext) paginationNext.disabled = state.page >= totalPages;
      if (paginationStatus) paginationStatus.textContent = `${state.page} / ${totalPages}`;
    };

    const goToPage = (page) => {
      const orderedContacts = sortContacts(getVisibleContacts());
      const totalPages = Math.max(1, Math.ceil(orderedContacts.length / pageSize));
      state.page = Math.min(Math.max(1, page), totalPages);
      const firstContact = orderedContacts[(state.page - 1) * pageSize];
      if (firstContact) state.selectedId = firstContact.id;
      render();
    };

    const selectContact = (contact) => {
      if (!contact) return;
      const orderedContacts = sortContacts(getVisibleContacts());
      const index = orderedContacts.findIndex((item) => item.id === contact.id);
      if (index >= 0) state.page = Math.floor(index / pageSize) + 1;
      state.selectedId = contact.id;
    };

    const getSelectedContact = () => contacts.find((contact) => contact.id === state.selectedId) || null;

    const relationshipBadge = (contact) => `<span class="crm-badge relationship-${escapeHtml(contact.relationshipType)}">${escapeHtml(contact.relationshipType)}</span>`;

    const renderDetail = (contact) => {
      if (!contact) {
        detail.innerHTML = `<div class="crm-detail-empty"><span aria-hidden="true">⌕</span><strong>暂时没有选中的联系人</strong><p>清空筛选后，选择一位联系人查看详情。</p></div>`;
        if (detailActivity) {
          detailActivity.hidden = true;
          detailActivity.innerHTML = '';
        }
        return;
      }

      const organization = [contact.role, contact.organization].filter(Boolean).join(' · ');
      const detailTags = [...new Set([contact.relationshipType, ...(contact.tags || [])].filter(Boolean))].slice(0, 4);
      const detailTagMarkup = detailTags.map((tag, index) => {
        const tone = index === 0 ? `relationship-${contact.relationshipType}` : index === 1 ? 'is-soft-green' : index === 2 ? 'is-soft-blue' : 'is-soft-yellow';
        return `<span class="crm-detail-tag-chip crm-badge ${escapeHtml(tone)}">${escapeHtml(tag)}<b aria-hidden="true">×</b></span>`;
      }).join('');
      const note = (contact.notes || '还没有备注').split('\n')[0];
      const longNotice = isLongNoContact(contact) ? '<div class="crm-long-notice"><strong>超过 45 天未联系</strong><span>可以安排一次轻松的问候，保持关系的温度。</span></div>' : '';
      const interactions = (contact.interactions || []).map((interaction) => `
        <li>
          <span class="crm-timeline-icon is-${interactionTone(interaction.type)}" aria-hidden="true">${escapeHtml(interaction.type.slice(0, 1))}</span>
          <div>
            <div class="crm-timeline-meta"><time datetime="${escapeHtml(interaction.date)}">${formatDate(interaction.date)}</time><span>${escapeHtml(interaction.type)}</span></div>
            <p data-crm-tooltip="${escapeHtml(interaction.summary)}">${escapeHtml(interaction.summary)}</p>
          </div>
        </li>`).join('');
      detail.innerHTML = `
        <div class="crm-detail-hero">
          <header class="crm-detail-identity">
            <span class="crm-detail-avatar tone-${escapeHtml(contact.avatarTone)}" aria-hidden="true">${escapeHtml(contact.initials || contact.name.slice(0, 2))}</span>
            <div class="crm-detail-name">
              <div class="crm-detail-name-heading"><h2 id="crm-detail-title">${escapeHtml(contact.name)}</h2><span class="crm-detail-favorite" aria-label="重要联系人">★</span></div>
              <p>${escapeHtml(organization)}</p>
              <p class="crm-detail-intro">${escapeHtml(note)}</p>
            </div>
            <button class="crm-detail-edit" type="button" data-crm-edit-contact="${escapeHtml(contact.id)}" aria-label="编辑${escapeHtml(contact.name)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5.5 4 4M5 19l3.8-.8L19.3 7.7a2.1 2.1 0 0 1-3-3L5.8 15.2Z"></path></svg>编辑</button>
          </header>
          <aside class="crm-detail-note-card" aria-label="关系提醒"><img src="/assets/crm/detail-note.png" alt="和有趣的人一起，让生活更有趣" width="1375" height="1144" loading="eager" /></aside>
        </div>

        <div class="crm-detail-tags-row"><div class="crm-contact-tags">${detailTagMarkup}</div></div>

        <section class="crm-detail-info-card" aria-label="联系人信息">
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6.5 4.5 9 4l1.7 4.1-1.8 1.3a13 13 0 0 0 5.7 5.7l1.3-1.8L20 15l-.5 2.5c-.3 1.5-1.8 2.3-3.2 1.8A16.2 16.2 0 0 1 4.7 7.7C4.2 6.3 5 4.8 6.5 4.5Z"></path></svg></span><span class="crm-detail-info-label">手机</span><strong>${escapeHtml(contact.phone || '未填写')}</strong><button class="crm-detail-copy" type="button" data-crm-copy="${escapeHtml(contact.phone || '')}" aria-label="复制手机号"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg></button></div>
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 8.5h14M6.5 5h11A2.5 2.5 0 0 1 20 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5v-9A2.5 2.5 0 0 1 6.5 5Z"></path><path d="M8 12h.01M12 12h.01M16 12h.01M8 15.5h.01M12 15.5h.01M16 15.5h.01"></path></svg></span><span class="crm-detail-info-label">关系</span><strong>${escapeHtml(contact.relationshipType || '未填写')}</strong><span class="crm-detail-info-action" aria-hidden="true"></span></div>
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5.5" width="16" height="13" rx="2"></rect><path d="m5 7 7 5 7-5"></path></svg></span><span class="crm-detail-info-label">邮箱</span><strong>${escapeHtml(contact.email || '未填写')}</strong><button class="crm-detail-copy" type="button" data-crm-copy="${escapeHtml(contact.email || '')}" aria-label="复制邮箱"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg></button></div>
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 19.5V6.8A1.8 1.8 0 0 1 6.8 5h10.4A1.8 1.8 0 0 1 19 6.8v12.7H5Z"></path><path d="M8.5 9h7M8.5 12.5h7M8.5 16h4"></path></svg></span><span class="crm-detail-info-label">身份</span><strong>${escapeHtml(organization || '未填写')}</strong><span class="crm-detail-info-action" aria-hidden="true"></span></div>
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5.5" width="16" height="15" rx="2"></rect><path d="M8 3.5v4M16 3.5v4M4 10h16"></path></svg></span><span class="crm-detail-info-label">最近联系</span><strong>${formatDate(contact.lastContactAt)}</strong><span class="crm-detail-info-action" aria-hidden="true"></span></div>
          <div class="crm-detail-info-row"><span class="crm-detail-info-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4.5h12v15H6z"></path><path d="M8.5 9h7M8.5 12.5h5M8.5 16h4"></path></svg></span><span class="crm-detail-info-label">备注</span><strong>${escapeHtml(note)}</strong><button class="crm-detail-info-action crm-detail-edit-note" type="button" data-crm-edit-contact="${escapeHtml(contact.id)}" aria-label="编辑备注"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 19 3.3-.7L18.5 8.1a2 2 0 0 0-2.8-2.8L5.5 15.5Z"></path></svg></button></div>
        </section>
        ${longNotice}

        <div class="crm-detail-actions" aria-label="联系人操作">
          <button class="is-primary" type="button" data-crm-log-interaction="${escapeHtml(contact.id)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 18.5 6 14l9.8-9.8a2.1 2.1 0 0 1 3 3L9 17Z"></path><path d="m13.5 6.5 4 4"></path></svg>记录互动</button>
          <button type="button" data-crm-add-note="${escapeHtml(contact.id)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.5h9l3 3v12H6z"></path><path d="M14 4.5v4h4M9 13h6M9 16h5"></path></svg>添加备注</button>
          <button type="button" data-crm-followup="${escapeHtml(contact.id)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17.5h10l-1.1-1.8V11a3.9 3.9 0 0 0-7.8 0v4.7Z"></path><path d="M9.5 19.5h5"></path></svg>设置提醒</button>
        </div>
`;

      if (detailActivity) {
        detailActivity.hidden = false;
        detailActivity.innerHTML = `<div class="crm-detail-section crm-timeline-section">
          <div class="crm-section-title-row">
            <h3 id="crm-timeline-title">最近互动记录</h3>
            <button class="crm-inline-link" type="button" data-crm-view-timeline>查看全部</button>
          </div>
          <ol class="crm-timeline">${interactions || '<li class="crm-timeline-empty">还没有互动记录</li>'}</ol>
        </div>`;
      }
    };

    const renderRelatedTasks = (contact) => {
      if (!relatedTasks) return;
      const taskList = relatedTasks.querySelector('.crm-task-list');
      if (!taskList) return;
      taskList.innerHTML = contact?.linkedTasks?.length ? contact.linkedTasks.map((task) => `
        <li>
          <span class="crm-task-checkbox" aria-hidden="true"></span>
          <strong data-crm-tooltip="${escapeHtml(task.title)}">${escapeHtml(task.title)}</strong>
          <span class="crm-task-status is-${taskTone(task.status)}">${escapeHtml(task.status)}</span>
          <time datetime="${escapeHtml(task.dueDate || '')}">${formatDate(task.dueDate)}</time>
        </li>`).join('') : '<li class="crm-task-empty">暂无关联任务</li>';
    };

    const renderStats = () => {
      const today = contacts.filter((contact) => followupBucket(contact) === 'today').length;
      const overdue = contacts.filter((contact) => followupBucket(contact) === 'overdue').length;
      const weeklyInteractions = contacts.reduce((total, contact) => total + (contact.interactions || []).filter((interaction) => {
        const distance = dateDistance(interaction.date, crmToday);
        return distance !== null && distance >= 0 && distance <= 7;
      }).length, 0);
      const values = { contacts: contacts.length, today, overdue, weekly: weeklyInteractions };
      Object.entries(values).forEach(([key, value]) => {
        const node = query(`[data-crm-stat-value="${key}"]`);
        if (node) node.textContent = String(value);
      });
      const todayHint = query('[data-crm-today-count]');
      if (todayHint) todayHint.textContent = `${today} 人`;
      const counts = {
        all: contacts.length,
        today,
        new: contacts.filter(isRecentlyAdded).length,
        long: contacts.filter(isLongNoContact).length,
      };
      Object.entries(counts).forEach(([key, value]) => {
        const node = query(`[data-crm-filter-count="${key}"]`);
        if (node) node.textContent = String(value);
      });
      ['家人', '朋友', '同学', '合作伙伴', '客户'].forEach((type) => {
        const node = query(`[data-crm-relationship-count="${type}"]`);
        if (node) node.textContent = String(contacts.filter((contact) => contact.relationshipType === type).length);
      });
    };

    const renderFollowupBoard = () => {
      const groups = {
        today: contacts.filter((contact) => followupBucket(contact) === 'today'),
        overdue: contacts.filter((contact) => followupBucket(contact) === 'overdue'),
        next7: contacts.filter((contact) => followupBucket(contact) === 'next7'),
      };
      Object.entries(groups).forEach(([key, group]) => {
        const count = query(`[data-crm-followup-count="${key}"]`);
        const items = query(`[data-crm-followup-items="${key}"]`);
        if (count) count.textContent = String(group.length);
        if (items) items.innerHTML = group.length ? group.map((contact) => `<div class="crm-followup-item" data-contact-id="${escapeHtml(contact.id)}" tabindex="0" role="button">
          <strong>${escapeHtml(contact.name)}</strong><span>${escapeHtml(contact.role || '未填写身份')}</span><b>${escapeHtml(key === 'next7' ? formatDate(contact.nextFollowUpAt) : (contact.notes || '还没有备注').split('\n')[0])}</b>${key === 'overdue' ? `<em>${followupText(contact)}</em>` : ''}
        </div>`).join('') : '<div class="crm-followup-empty">暂无安排</div>';
      });
      if (noFollowups) noFollowups.hidden = Object.values(groups).some((group) => group.length);
    };

    const renderTimeline = (visibleContacts) => {
      if (!timelineList) return;
      const items = visibleContacts.flatMap((contact) => (contact.interactions || []).map((interaction) => ({ contact, interaction })))
        .sort((first, second) => dateValue(second.interaction.date) - dateValue(first.interaction.date));
      if (timelineCount) timelineCount.textContent = String(items.length);
      timelineList.innerHTML = items.length ? items.map(({ contact, interaction }) => `
        <li class="crm-global-timeline-item" data-contact-id="${escapeHtml(contact.id)}" tabindex="0" role="button">
          <span class="crm-timeline-icon is-${interactionTone(interaction.type)}" aria-hidden="true">${escapeHtml(interaction.type.slice(0, 1))}</span>
          <div>
            <div class="crm-timeline-meta"><strong>${escapeHtml(contact.name)}</strong><time datetime="${escapeHtml(interaction.date)}">${formatDate(interaction.date)}</time><span>${escapeHtml(interaction.type)}</span></div>
            <p>${escapeHtml(interaction.summary)}</p>
          </div>
        </li>`).join('') : '<li class="crm-timeline-empty">当前筛选下还没有互动记录</li>';
    };

    const getContact = (id) => contacts.find((contact) => contact.id === id) || null;
    const getField = (form, name) => form?.elements?.namedItem(name);

    const closeOverlay = () => {
      if (!overlay) return;
      overlay.hidden = true;
      surfaces.forEach((surface) => { surface.hidden = true; });
      document.body.classList.remove('crm-modal-open');
    };

    const openSurface = (name) => {
      if (!overlay) return;
      closeMenus();
      overlay.hidden = false;
      surfaces.forEach((surface) => { surface.hidden = surface.dataset.crmSurface !== name; });
      document.body.classList.add('crm-modal-open');
    };

    const openContactSurface = (contact = null) => {
      if (!contactForm) return;
      contactForm.dataset.mode = contact ? 'edit' : 'add';
      contactFormError.hidden = true;
      if (contactFormTitle) contactFormTitle.textContent = contact ? '编辑联系人' : '新增联系人';
      if (contactSubmit) contactSubmit.textContent = contact ? '保存修改' : '保存联系人';
      getField(contactForm, 'name').value = contact?.name || '';
      getField(contactForm, 'role').value = contact?.role || '';
      getField(contactForm, 'relationshipType').value = contact?.relationshipType || '朋友';
      getField(contactForm, 'tags').value = contact?.tags?.join('，') || '';
      getField(contactForm, 'phone').value = contact?.phone || '';
      getField(contactForm, 'email').value = contact?.email || '';
      getField(contactForm, 'notes').value = contact?.notes || '';
      activeSurfaceContactId = contact?.id || '';
      openSurface('contact');
      getField(contactForm, 'name')?.focus();
    };

    const openInteractionSurface = (contact) => {
      if (!contactForm || !interactionForm || !contact) return;
      activeSurfaceContactId = contact.id;
      selectedInteractionType = '微信';
      if (interactionContact) interactionContact.textContent = contact.name;
      getField(interactionForm, 'date').value = crmToday;
      getField(interactionForm, 'summary').value = '';
      [...document.querySelectorAll('[data-crm-interaction-type]')].forEach((button) => button.classList.toggle('is-active', button.dataset.crmInteractionType === selectedInteractionType));
      openSurface('interaction');
      getField(interactionForm, 'summary')?.focus();
    };

    const openFollowupSurface = (contact) => {
      if (!followupForm || !contact) return;
      activeSurfaceContactId = contact.id;
      if (followupContact) followupContact.textContent = contact.name;
      getField(followupForm, 'date').value = contact.nextFollowUpAt || crmToday;
      queryAll('[data-crm-followup-quick]').forEach((button) => button.classList.remove('is-active'));
      openSurface('followup');
      getField(followupForm, 'date')?.focus();
    };

    const openConvertSurface = (contact) => {
      if (!contact) return;
      activeSurfaceContactId = contact.id;
      const contactName = document.querySelector('[data-crm-convert-contact]');
      if (contactName) contactName.textContent = contact.name;
      openSurface('convert');
    };

    const showToast = (message) => {
      if (!toast || !toastMessage) return;
      window.clearTimeout(toastTimer);
      toastMessage.textContent = message;
      toast.hidden = false;
      toast.classList.add('is-visible');
      toastTimer = window.setTimeout(() => {
        toast.classList.remove('is-visible');
        toast.hidden = true;
      }, 3200);
    };

    const addDays = (value, amount) => new Date(dateValue(value) + amount * 86400000).toISOString().slice(0, 10);

    const markContacted = (contact) => {
      if (!contact) return;
      const wasPending = ['today', 'overdue'].includes(followupBucket(contact));
      contact.lastContactAt = crmToday;
      if (wasPending) contact.nextFollowUpAt = undefined;
      contact.relationshipStatus = contact.relationshipStatus === '待维护' ? '普通' : contact.relationshipStatus;
      if (!(contact.interactions || []).some((interaction) => interaction.date === crmToday && interaction.summary === '已标记为本次联系完成。')) {
        contact.interactions = contact.interactions || [];
        contact.interactions.unshift({ id: `interaction-${Date.now()}`, date: crmToday, type: '其他', summary: '已标记为本次联系完成。' });
      }
      selectContact(contact);
      render();
      showToast(`已记录 ${contact.name}，本次跟进已完成`);
    };

    const setControlLabel = (button, label) => {
      if (button) button.innerHTML = `${escapeHtml(label)} <span aria-hidden="true">⌄</span>`;
    };

    const closeMenus = () => queryAll('.crm-toolbar-menu').forEach((menu) => {
      menu.hidden = true;
      const trigger = menu.parentElement?.querySelector('.crm-select-button');
      trigger?.setAttribute('aria-expanded', 'false');
    });

    const updateFilterSummary = () => {
      const labels = [];
      if (state.query.trim()) labels.push(`搜索：${state.query.trim()}`);
      if (state.smart !== 'all') labels.push({ today: '今日待跟进', new: '最近新增', long: '长期未联系' }[state.smart]);
      if (state.relationship) labels.push(state.relationship);
      if (state.tag) labels.push(`标签：${state.tag}`);
      if (summaryText) summaryText.textContent = labels.join(' · ');
      if (summary) summary.hidden = labels.length === 0;
    };

    const renderMobileFilterChips = () => {
      if (!mobileFilterChips) return;
      const chips = [
        { label: '全部', attribute: 'data-crm-filter="all"', active: state.smart === 'all' && !state.relationship && !state.tag },
        { label: '今天待跟进', attribute: 'data-crm-filter="today"', active: state.smart === 'today' },
        { label: '长期未联系', attribute: 'data-crm-filter="long"', active: state.smart === 'long' },
        ...['家人', '朋友', '同学', '合作伙伴', '客户'].map((type) => ({
          label: type,
          attribute: `data-crm-relationship="${type}"`,
          active: state.relationship === type,
        })),
      ];
      if (state.tag) chips.push({ label: `标签：${state.tag}`, attribute: `data-crm-tag="${escapeHtml(state.tag)}"`, active: true });
      mobileFilterChips.innerHTML = chips.map((chip) => `<button class="crm-mobile-filter-chip${chip.active ? ' is-active' : ''}" type="button" ${chip.attribute}>${escapeHtml(chip.label)}</button>`).join('');
    };

    const closeMobileFilterSheet = () => {
      root.classList.remove('is-mobile-filter-sheet-open');
      if (mobileFilterScrim) mobileFilterScrim.hidden = true;
      mobileFilterTrigger?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('crm-mobile-filter-open');
    };

    const openMobileFilterSheet = () => {
      closeMobileDetail();
      root.classList.add('is-mobile-filter-sheet-open');
      if (mobileFilterScrim) mobileFilterScrim.hidden = false;
      mobileFilterTrigger?.setAttribute('aria-expanded', 'true');
      document.body.classList.add('crm-mobile-filter-open');
      mobileFilterClose?.focus({ preventScroll: true });
    };

    const closeMobileDetail = () => {
      root.classList.remove('is-mobile-detail-open');
      if (mobileDetailScrim) mobileDetailScrim.hidden = true;
      document.body.classList.remove('crm-mobile-detail-open');
    };

    const openMobileDetail = (contact) => {
      if (!contact || !window.matchMedia('(max-width: 719px)').matches) return;
      closeMobileFilterSheet();
      selectContact(contact);
      render();
      root.classList.add('is-mobile-detail-open');
      if (mobileDetailScrim) mobileDetailScrim.hidden = false;
      document.body.classList.add('crm-mobile-detail-open');
      mobileDetailClose?.focus({ preventScroll: true });
    };

    const render = () => {
      renderStats();
      renderFollowupBoard();
      const visibleContacts = getVisibleContacts();
      const orderedContacts = sortContacts(visibleContacts);
      const totalPages = Math.max(1, Math.ceil(orderedContacts.length / pageSize));
      state.page = Math.min(Math.max(1, state.page), totalPages);
      const pageContacts = orderedContacts.slice((state.page - 1) * pageSize, state.page * pageSize);
      const visibleIds = new Set(pageContacts.map((contact) => contact.id));

      orderedContacts.forEach((contact) => {
        const card = query(`[data-contact-id="${CSS.escape(contact.id)}"]`);
        if (card && card.parentElement === list) list.append(card);
      });
      contactCards.forEach((card) => {
        const isVisible = visibleIds.has(card.dataset.contactId);
        card.hidden = !isVisible;
        const isSelected = card.dataset.contactId === state.selectedId;
        card.classList.toggle('is-selected', isSelected);
        card.setAttribute('aria-selected', String(isSelected));
      });
      if (emptyState) emptyState.hidden = visibleContacts.length !== 0;
      if (contactCount) contactCount.textContent = String(visibleContacts.length);
      if (listTitle) listTitle.firstChild.textContent = '联系人 ';
      renderPagination(visibleContacts.length);
      setFilterPanel(state.filterPanel);

      queryAll('[data-crm-filter]').forEach((button) => {
        const isActive = button.dataset.crmFilter === state.smart && !state.relationship && !state.tag;
        button.classList.toggle('is-active', isActive);
      });
      queryAll('[data-crm-relationship]').forEach((button) => {
        button.classList.toggle('is-active', button.dataset.crmRelationship === state.relationship);
      });
      queryAll('[data-crm-tag]').forEach((button) => button.classList.toggle('is-active', button.dataset.crmTag === state.tag));
      queryAll('[data-crm-menu-tag]').forEach((button) => button.classList.toggle('is-active', button.dataset.crmMenuTag === state.tag));

      const tagButton = query('[data-crm-tag-filter]');
      const sortButton = query('[data-crm-sort]');
      setControlLabel(tagButton, state.tag || '全部标签');
      setControlLabel(sortButton, { recent: '按最近联系', followup: '按下次跟进', importance: '按重要程度' }[state.sort]);
      queryAll('[data-crm-menu-sort]').forEach((button) => button.classList.toggle('is-active', button.dataset.crmMenuSort === state.sort));

      queryAll('[data-crm-view]').forEach((button) => {
        const isActive = button.dataset.crmView === state.primaryView;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-selected', String(isActive));
      });
      const isContactsView = state.primaryView === 'contacts';
      const isDashboardView = state.primaryView === 'dashboard';
      const isSecondaryView = !isContactsView;
      leftColumn?.toggleAttribute('hidden', !isContactsView);
      detailColumn?.toggleAttribute('hidden', !isContactsView);
      overviewRow?.toggleAttribute('hidden', isDashboardView);
      dashboardRow?.toggleAttribute('hidden', !isSecondaryView);
      dashboardRow?.classList.toggle('is-dashboard-view', isDashboardView);
      workspace?.classList.toggle('is-contacts-view', isContactsView);
      workspace?.classList.toggle('is-dashboard-view', isDashboardView);
      if (dashboardTitle) dashboardTitle.textContent = primaryViewTitles[state.primaryView];
      if (dashboardKicker) dashboardKicker.textContent = 'RELATIONSHIP DASHBOARDS';
      centerColumn?.classList.remove('is-crm-activity-view');
      contactPanel.hidden = false;
      followupBoard.hidden = !isDashboardView;
      if (timelinePanel) timelinePanel.hidden = !isDashboardView;
      renderTimeline(visibleContacts);

      const selected = pageContacts.find((contact) => contact.id === state.selectedId) || pageContacts[0] || null;
      if (selected && selected.id !== state.selectedId) state.selectedId = selected.id;
      renderDetail(selected);
      renderRelatedTasks(selected);
      renderMobileFilterChips();
      updateFilterSummary();
    };

    const resetFilters = () => {
      state.query = '';
      state.smart = 'all';
      state.relationship = '';
      state.tag = '';
      state.page = 1;
      searchInputs.forEach((input) => { input.value = ''; });
      closeMenus();
      render();
    };

    const setPrimaryView = (view, { replace = false, scroll = true } = {}) => {
      if (!primaryViews.includes(view)) view = 'contacts';
      state.primaryView = view;
      state.page = 1;
      const params = new URLSearchParams(window.location.search);
      params.set('view', view);
      const queryString = params.toString();
      const nextUrl = `${window.location.pathname}${queryString ? `?${queryString}` : ''}${window.location.hash}`;
      if (replace) window.history.replaceState(null, '', nextUrl);
      else window.history.pushState(null, '', nextUrl);
      render();
      if (scroll) (view === 'contacts' ? contactPanel : dashboardRow)?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    searchInputs.forEach((input) => input.addEventListener('input', (event) => {
      state.query = event.currentTarget.value;
      state.page = 1;
      searchInputs.forEach((peer) => { if (peer !== event.currentTarget) peer.value = state.query; });
      render();
    }));

    contactForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const name = getField(contactForm, 'name').value.trim();
      if (!name) {
        contactFormError.hidden = false;
        getField(contactForm, 'name')?.focus();
        return;
      }
      const relationshipType = getField(contactForm, 'relationshipType').value;
      const inputTags = getField(contactForm, 'tags').value.split(/[，,]/).map((tag) => tag.trim()).filter(Boolean);
      const tags = [relationshipType, ...inputTags.filter((tag) => tag !== relationshipType)];
      const values = {
        name,
        role: getField(contactForm, 'role').value.trim() || '未填写身份',
        relationshipType,
        tags,
        phone: getField(contactForm, 'phone').value.trim() || '未填写',
        email: getField(contactForm, 'email').value.trim() || '未填写',
        notes: getField(contactForm, 'notes').value.trim() || '还没有备注',
      };
      if (contactForm.dataset.mode === 'edit') {
        const contact = getContact(activeSurfaceContactId);
        if (contact) Object.assign(contact, values);
        showToast(`已保存 ${name} 的联系人信息`);
      } else {
        const relationshipTones = { 家人: 'sage', 朋友: 'blue', 同学: 'slate', 合作伙伴: 'amber', 客户: 'rose' };
        const contact = {
          id: `crm-${Date.now()}`,
          initials: name.slice(0, 2),
          avatarTone: relationshipTones[values.relationshipType] || 'amber',
          createdAt: crmToday,
          relationshipStatus: '普通',
          importance: 3,
          interactions: [],
          linkedTasks: [],
          ...values,
        };
        contacts.unshift(contact);
        state.page = 1;
        selectContact(contact);
        showToast(`已新增联系人 ${name}`);
      }
      rebuildContactCards();
      closeOverlay();
      render();
    });

    interactionForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const contact = getContact(activeSurfaceContactId);
      const summaryText = getField(interactionForm, 'summary').value.trim();
      if (!contact || !summaryText) return;
      const date = getField(interactionForm, 'date').value || crmToday;
      contact.interactions = contact.interactions || [];
      contact.interactions.unshift({ id: `interaction-${Date.now()}`, date, type: selectedInteractionType, summary: summaryText });
      contact.lastContactAt = date;
      selectContact(contact);
      closeOverlay();
      render();
      showToast(`已记录与 ${contact.name} 的互动`);
    });

    followupForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const contact = getContact(activeSurfaceContactId);
      if (!contact) return;
      contact.nextFollowUpAt = getField(followupForm, 'date').value || crmToday;
      selectContact(contact);
      closeOverlay();
      render();
      showToast(`已为 ${contact.name} 安排跟进`);
    });

    [...document.querySelectorAll('[data-crm-followup-quick]')].forEach((button) => button.addEventListener('click', () => {
      const date = addDays(crmToday, Number(button.dataset.crmFollowupQuick));
      getField(followupForm, 'date').value = date;
      [...document.querySelectorAll('[data-crm-followup-quick]')].forEach((choice) => choice.classList.toggle('is-active', choice === button));
    }));

    overlay?.addEventListener('click', (event) => {
      const target = event.target.closest('button, [data-crm-close-overlay]');
      if (!target || !overlay.contains(target)) return;
      if (target.matches('[data-crm-close-overlay]')) {
        closeOverlay();
        return;
      }
      if (target.matches('[data-crm-interaction-type]')) {
        selectedInteractionType = target.dataset.crmInteractionType;
        [...document.querySelectorAll('[data-crm-interaction-type]')].forEach((button) => button.classList.toggle('is-active', button === target));
        return;
      }
      if (target.matches('[data-crm-confirm-convert]')) {
        const contact = getContact(activeSurfaceContactId);
        if (!contact) return;
        contact.linkedTasks = contact.linkedTasks || [];
        if (!contact.linkedTasks.some((task) => task.title === `跟进 ${contact.name}`)) {
          contact.linkedTasks.unshift({ id: `task-${Date.now()}`, title: `跟进 ${contact.name}`, status: '待开始', dueDate: contact.nextFollowUpAt || crmToday });
        }
        state.selectedId = contact.id;
        closeOverlay();
        render();
        showToast(`已生成任务：跟进 ${contact.name}`);
      }
    });

    root.addEventListener('click', (event) => {
      const target = event.target.closest('button, [data-contact-id], [data-crm-close-overlay], [data-crm-mobile-filter-close], [data-crm-mobile-detail-close]');
      if (!target || !root.contains(target)) return;

      if (target.matches('[data-crm-mobile-filter-sheet]')) {
        if (root.classList.contains('is-mobile-filter-sheet-open')) closeMobileFilterSheet();
        else openMobileFilterSheet();
        return;
      }
      if (target.matches('[data-crm-mobile-filter-close]')) {
        closeMobileFilterSheet();
        return;
      }
      if (target.matches('[data-crm-mobile-detail-close]')) {
        closeMobileDetail();
        return;
      }
      if (target.matches('[data-crm-close-overlay]')) {
        closeOverlay();
        return;
      }
      if (target.matches('[data-crm-filter-panel]')) {
        setFilterPanel(target.dataset.crmFilterPanel);
        return;
      }
      if (target.matches('[data-crm-add-contact]')) {
        openContactSurface();
        return;
      }
      if (target.matches('[data-crm-copy]')) {
        const value = target.dataset.crmCopy || '';
        if (!value) {
          showToast('暂无可复制的内容');
          return;
        }
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(value)
            .then(() => showToast('已复制到剪贴板'))
            .catch(() => showToast('复制失败，请手动选择文本'));
        } else {
          showToast('浏览器暂不支持复制，请手动选择文本');
        }
        return;
      }
      if (target.matches('[data-crm-add-note]')) {
        const contact = getContact(target.dataset.crmAddNote);
        if (contact) {
          state.selectedId = contact.id;
          render();
          openContactSurface(contact);
          getField(contactForm, 'notes')?.focus();
        }
        return;
      }
      if (target.matches('[data-crm-edit-contact]')) {
        const contact = getContact(target.dataset.crmEditContact);
        if (contact) {
          state.selectedId = contact.id;
          render();
          openContactSurface(contact);
        }
        return;
      }
      if (target.matches('[data-crm-log-interaction]')) {
        const contact = getContact(target.dataset.crmLogInteraction);
        if (contact) openInteractionSurface(contact);
        return;
      }
      if (target.matches('[data-crm-followup]')) {
        const contact = getContact(target.dataset.crmFollowup);
        if (contact) openFollowupSurface(contact);
        return;
      }
      if (target.matches('[data-crm-mark-contacted]')) {
        markContacted(getContact(target.dataset.crmMarkContacted));
        return;
      }
      if (target.matches('[data-crm-convert-task]')) {
        openConvertSurface(getContact(target.dataset.crmConvertTask));
        return;
      }
      if (target.matches('[data-crm-interaction-type]')) {
        selectedInteractionType = target.dataset.crmInteractionType;
        queryAll('[data-crm-interaction-type]').forEach((button) => button.classList.toggle('is-active', button === target));
        return;
      }
      if (target.matches('[data-crm-confirm-convert]')) {
        const contact = getContact(activeSurfaceContactId);
        if (!contact) return;
        contact.linkedTasks = contact.linkedTasks || [];
        if (!contact.linkedTasks.some((task) => task.title === `跟进 ${contact.name}`)) {
          contact.linkedTasks.unshift({ id: `task-${Date.now()}`, title: `跟进 ${contact.name}`, status: '待开始', dueDate: contact.nextFollowUpAt || crmToday });
        }
        state.selectedId = contact.id;
        closeOverlay();
        render();
        showToast(`已生成任务：跟进 ${contact.name}`);
        return;
      }

      if (target.matches('[data-crm-tag-filter]')) {
        const menu = query('[data-crm-tag-menu]');
        const shouldOpen = menu?.hidden;
        closeMenus();
        if (menu && shouldOpen) {
          menu.hidden = false;
          target.setAttribute('aria-expanded', 'true');
        }
        return;
      }
      if (target.matches('[data-crm-sort]')) {
        const menu = query('[data-crm-sort-menu]');
        const shouldOpen = menu?.hidden;
        closeMenus();
        if (menu && shouldOpen) {
          menu.hidden = false;
          target.setAttribute('aria-expanded', 'true');
        }
        return;
      }
      if (target.matches('[data-crm-menu-tag]')) {
        state.tag = target.dataset.crmMenuTag || '';
        state.smart = 'all';
        state.relationship = '';
        state.page = 1;
        closeMenus();
        render();
        return;
      }
      if (target.matches('[data-crm-menu-sort]')) {
        state.sort = target.dataset.crmMenuSort;
        state.page = 1;
        closeMenus();
        render();
        return;
      }
      if (target.matches('[data-crm-clear-filters]')) {
        resetFilters();
        return;
      }
      if (target.matches('[data-crm-filter]')) {
        const filter = target.dataset.crmFilter;
        if (filter === 'all') {
          resetFilters();
          closeMobileFilterSheet();
          return;
        }
        state.smart = filter;
        state.relationship = '';
        state.tag = '';
        state.page = 1;
        render();
        closeMobileFilterSheet();
        return;
      }
      if (target.matches('[data-crm-relationship]')) {
        state.smart = 'all';
        state.relationship = target.dataset.crmRelationship;
        state.tag = '';
        state.page = 1;
        render();
        closeMobileFilterSheet();
        return;
      }
      if (target.matches('[data-crm-tag]')) {
        state.smart = 'all';
        state.relationship = '';
        state.tag = target.dataset.crmTag;
        state.page = 1;
        render();
        closeMobileFilterSheet();
        return;
      }
      if (target.matches('[data-crm-page-prev]')) {
        goToPage(state.page - 1);
        return;
      }
      if (target.matches('[data-crm-page-next]')) {
        goToPage(state.page + 1);
        return;
      }
      if (target.matches('[data-crm-page]')) {
        goToPage(Number(target.dataset.crmPage));
        return;
      }
      if (target.matches('[data-crm-view]')) {
        setPrimaryView(target.dataset.crmView);
        return;
      }
      if (target.matches('[data-crm-view-all], [data-crm-view-contacts]')) {
        resetFilters();
        setPrimaryView('contacts');
        return;
      }
      if (target.matches('[data-crm-view-dashboard], [data-crm-view-followups], [data-crm-view-timeline]')) {
        setPrimaryView('dashboard');
        return;
      }

      const item = target.closest('[data-contact-id]');
      if (item && !target.closest('button')) {
        const contact = getContact(item.dataset.contactId);
        openMobileDetail(contact);
        if (!window.matchMedia('(max-width: 719px)').matches) {
          selectContact(contact);
          render();
        }
      }
    });

    root.addEventListener('keydown', (event) => {
      if (!['Enter', ' '].includes(event.key)) return;
      const item = event.target.closest('[data-contact-id]');
      if (!item || event.target.matches('button, input')) return;
      event.preventDefault();
      const contact = getContact(item.dataset.contactId);
      openMobileDetail(contact);
      if (!window.matchMedia('(max-width: 719px)').matches) {
        selectContact(contact);
        render();
      }
    });

    document.addEventListener('click', (event) => {
      if (!event.target.closest('.crm-toolbar-menu-wrap')) closeMenus();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeMenus();
      if (overlay && !overlay.hidden) closeOverlay();
      closeMobileFilterSheet();
      closeMobileDetail();
      hideTooltip();
    });

    window.addEventListener('popstate', () => {
      state.primaryView = readPrimaryView();
      render();
    });

    rebuildContactCards();
    setPrimaryView(state.primaryView, { replace: true, scroll: false });
  }
</script>
