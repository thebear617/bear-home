---
import { getNavigationItems } from '../data/navigation.js';

const rootHref = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html' ? './' : '../';
const items = getNavigationItems(rootHref);
const active = Astro.props.active ?? 'routes';
---
<button class="sidebar-toggle" data-sidebar-open type="button" aria-label="展开侧边栏" aria-expanded="false">☰</button>
<div class="sidebar-backdrop" data-sidebar-close></div>
<nav class="sidebar" aria-label="主导航">
  <div class="sidebar-brand">
    <button class="sidebar-close" data-sidebar-close type="button" aria-label="关闭侧边栏">✕</button>
    <button class="sidebar-collapse" data-sidebar-collapse type="button" aria-label="收起侧边栏" title="收起侧边栏">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="4" width="17" height="16" rx="2"></rect><path d="M9 4v16"></path><path d="m15 9-3 3 3 3"></path></svg>
    </button>
    <svg class="sidebar-brand-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="4" r="2"></circle><circle cx="18" cy="8" r="2"></circle><circle cx="20" cy="16" r="2"></circle><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"></path></svg>
    <p class="sidebar-eyebrow">BEAR HOME</p>
    <h1 class="sidebar-title">熊窝</h1>
    <span class="sidebar-subtitle">个人主页</span>
  </div>
  <div class="sidebar-nav">
    {items.map((item) => (
      <a class:list={['sidebar-item', { active: active === item.id }]} href={item.href} aria-current={active === item.id ? 'page' : undefined}>
        <span class="sidebar-icon">{item.sidebarIcon}</span>
        <span>{item.title}</span>
      </a>
    ))}
  </div>
</nav>
