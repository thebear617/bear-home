---
const { items = [], className = '', showFullName = false } = Astro.props;
---
<div class:list={['lol-picks', className]}>
  {items.map((item) => (
    <figure class="lol-pick">
      <img src={item.icon} alt={item.fullName || item.name} loading="lazy">
      <figcaption>{item.name}</figcaption>
      {showFullName && item.fullName && <small>{item.fullName}</small>}
    </figure>
  ))}
</div>
