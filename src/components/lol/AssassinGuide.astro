---
import ItemPicks from './ItemPicks.astro';
const { guide } = Astro.props;
---
<div class="lol-guide-panel lol-assassin-guide">
  <header class="lol-hero"><h1>{guide.title}</h1><p>{guide.subtitle}</p><a class="lol-source" href={guide.source.url} target="_blank" rel="noopener">来源：{guide.source.author} · 查看原视频 ↗</a></header>
  <section class:list={['lol-build', `lol-tone-${guide.spellblade.tone}`]}>
    <div class="lol-build-heading"><h2>{guide.spellblade.title}</h2><span>{guide.spellblade.tagline}</span></div>
    {guide.spellblade.rows.map((row) => (
      <div class="lol-row"><div class:list={['lol-row-label', `lol-label-${row.type}`]}>{row.label}</div><ItemPicks items={row.items} /></div>
    ))}
  </section>
  <section class="lol-build lol-tone-purple lol-assassin-custom">
    <div class="lol-build-heading"><h2>不带咒刃</h2><span>一人一套 · 按英雄直接查表</span></div>
    <div class="lol-assassin-grid">
      {guide.customBuilds.map((build) => (
        <article class="lol-assassin-card">
          <header><img src={build.champion.icon} alt={build.champion.name} loading="lazy"><div><h3>{build.champion.name}</h3><p>{build.note}</p></div></header>
          <div class="lol-assassin-line"><span>出门</span><ItemPicks items={build.starter} className="lol-assassin-picks" /></div>
          <div class="lol-assassin-line"><span>神装</span><ItemPicks items={build.items} className="lol-assassin-picks" /></div>
        </article>
      ))}
    </div>
  </section>
  <section class="lol-rules lol-assassin-rules"><h2>快速规则</h2><ul>{guide.quickRules.map((rule) => <li>{rule}</li>)}</ul></section>
</div>
