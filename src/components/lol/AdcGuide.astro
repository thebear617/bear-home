---
import ItemPicks from './ItemPicks.astro';
const { guide } = Astro.props;
---
<div class="lol-guide-panel lol-adc-guide">
  <header class="lol-hero lol-adc-hero">
    <h1><span class="lol-adc-title-part">{guide.titlePrefix}</span><span class="lol-adc-title-divider">｜</span><span class="lol-adc-title-part">{guide.titleMain}</span></h1>
    <p>{guide.subtitle}</p>
    <a class="lol-source" href={guide.source.url} target="_blank" rel="noopener">来源：{guide.source.author} · 查看原视频 ↗</a>
  </header>
  <section class="lol-adc-card lol-formula-card">
    <div class="lol-adc-heading"><span>CORE FORMULA</span><h2>两件套公式</h2></div>
    <div class="lol-formula-steps">
      {guide.formula.map((step, index) => (
        <article class="lol-formula-step">
          <div class="lol-step-topline"><span class="lol-step-number">{index + 1}</span><div><h3>{step.label}</h3><strong>{step.kicker}</strong></div></div>
          <p>{step.note}</p>
          <ItemPicks items={step.items} className="lol-adc-picks" showFullName />
          {step.champions && <div class="lol-adc-exception"><span>仅这类英雄优先收集者</span><ItemPicks items={step.champions} className="lol-adc-picks" /></div>}
        </article>
      ))}
    </div>
  </section>
  <section class="lol-adc-card">
    <div class="lol-adc-heading"><span>CRIT CHECK</span><h2>11 级海克斯分支</h2></div>
    <div class="lol-branch-grid">
      {guide.branches.map((branch) => (
        <article class:list={['lol-branch-card', `lol-adc-tone-${branch.tone}`]}>
          <span class="lol-branch-badge">{branch.badge}</span><h3>{branch.title}</h3><p>{branch.note}</p>
          {branch.items && <ItemPicks items={branch.items} className="lol-adc-picks" />}
          {branch.champions && <div class="lol-adc-branch-champions"><span>适用英雄</span><ItemPicks items={branch.champions} className="lol-adc-picks" /></div>}
        </article>
      ))}
    </div>
  </section>
  <section class="lol-adc-card">
    <div class="lol-adc-heading"><span>AFTER CORE</span><h2>后续按需装备</h2><p>不是固定顺序，根据输出、续航和生存需求选择。</p></div>
    <div class="lol-later-grid">
      {guide.laterGroups.map((group) => (
        <article class:list={['lol-later-group', `lol-adc-tone-${group.tone}`]}><h3>{group.title}</h3>{group.note && <p>{group.note}</p>}<ItemPicks items={group.items} className="lol-adc-picks" /></article>
      ))}
    </div>
  </section>
  <section class="lol-rules lol-adc-rules"><h2>快速规则</h2><ul>{guide.quickRules.map((rule) => <li>{rule}</li>)}</ul><div class="lol-adc-boot"><span>三件套后</span><ItemPicks items={[guide.boot]} /></div></section>
</div>
